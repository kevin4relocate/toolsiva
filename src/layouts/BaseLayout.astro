---
import "@/styles/global.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import ToolExperience from "@/components/tools/ToolExperience.astro";
import CookieConsent from "@/components/privacy/CookieConsent.astro";
import SeoHead from "@/components/seo/SeoHead.astro";
import { siteConfig } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  image,
} = Astro.props;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  inLanguage: siteConfig.language,
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteConfig.url,
  logo: `${siteConfig.url}/favicon.svg`,
  email: siteConfig.contactEmail,
};
import { safeJsonForHtml } from "@/lib/safeJsonForHtml";
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <!-- Basic Consent Mode v2: no Google scripts load before opt-in. -->
    <script is:inline src="/analyticsConsent.js"></script>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      image={image}
    />
<script is:inline type="application/ld+json" set:html={safeJsonForHtml(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={safeJsonForHtml(organizationSchema)} />
  </head>
  <body class="text-zinc-100 antialiased">
    <a
      href="#main-content"
      class="focus-ring fixed left-4 top-3 z-[100] -translate-y-20 rounded-lg bg-white px-4 py-2 text-sm font-semibold text-zinc-950 transition focus:translate-y-0"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ToolExperience />
    <script is:inline src="/analyticsEvents.js"></script>
    <script is:inline src="/toolActions.js"></script>
    <CookieConsent />
  </body>
</html>
