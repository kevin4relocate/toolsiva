---
import type { ToolDefinition } from "@/types/tool";
import { getToolPath } from "@/types/tool";

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
---

<a
  href={getToolPath(tool)}
  class="focus-ring group block rounded-2xl border border-white/10 bg-white/[0.035] p-5 transition hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-white/[0.06]"
>
  <div class="mb-4 grid size-11 place-items-center rounded-xl bg-brand-500/10 text-xl text-brand-300">
    T
  </div>
  <h3 class="font-semibold text-white">{tool.name}</h3>
  <p class="mt-2 text-sm leading-6 text-zinc-400">{tool.shortDescription}</p>
</a>
