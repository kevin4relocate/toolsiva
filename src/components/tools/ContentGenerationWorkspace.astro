---
interface Props { mode: string; }
const { mode } = Astro.props;
---

<section class="rounded-2xl border border-white/10 bg-white/[0.02] p-4 sm:p-5" data-content-tools data-mode={mode}>
  <div class:list={[mode !== "random-text-generator" && "hidden"]}>
    <div class="grid gap-4 lg:grid-cols-[20rem_minmax(0,1fr)]">
      <div class="space-y-4 rounded-2xl border border-white/10 bg-zinc-950/50 p-4">
        <label class="grid gap-1.5 text-xs font-medium text-zinc-400">Output type
          <select data-random-type>
            <option value="words">Words</option><option value="sentences">Sentences</option>
            <option value="paragraphs" selected>Paragraphs</option><option value="mixed">Mixed test text</option>
          </select>
        </label>
        <label class="grid gap-1.5 text-xs font-medium text-zinc-400">Amount
          <input data-random-amount type="number" min="1" max="100" value="3" class="min-h-[2.875rem] rounded-xl border border-white/10 bg-zinc-950 px-3 text-sm text-zinc-100 outline-none" />
          <div
            data-random-limit
            class="rounded-xl border border-brand-400/30 bg-brand-500/10 px-3 py-2 text-xs font-semibold leading-5 text-brand-200"
          >
            Maximum: 500 paragraphs
          </div>
        </label>
        <div class="grid gap-2 text-sm text-zinc-300">
          <label class="flex items-center gap-2"><input data-random-option="numbers" type="checkbox" checked class="size-4 accent-brand-500" /> Include numbers</label>
          <label class="flex items-center gap-2"><input data-random-option="emoji" type="checkbox" checked class="size-4 accent-brand-500" /> Include emojis</label>
          <label class="flex items-center gap-2"><input data-random-option="special" type="checkbox" class="size-4 accent-brand-500" /> Include special characters</label>
          <label class="flex items-center gap-2"><input data-random-option="uppercase" type="checkbox" checked class="size-4 accent-brand-500" /> Include uppercase words</label>
          <label class="flex items-center gap-2"><input data-random-option="lineBreaks" type="checkbox" checked class="size-4 accent-brand-500" /> Add line breaks</label>
        </div>
        <label class="grid gap-1.5 text-xs font-medium text-zinc-400">Custom separator
          <input data-random-separator placeholder="Leave empty for spaces" class="min-h-[2.875rem] rounded-xl border border-white/10 bg-zinc-950 px-3 text-sm text-zinc-100 outline-none" />
        </label>
        <button data-generate type="button" class="min-h-[2.875rem] w-full rounded-xl bg-brand-500 px-4 text-sm font-bold text-white hover:bg-brand-400">Generate</button>
      </div>
      <div class="grid min-w-0 grid-rows-[auto_minmax(20rem,1fr)_auto] gap-3">
        <div class="flex items-center justify-between gap-3"><span class="text-sm font-semibold text-zinc-200">Generated text</span><span data-random-stats class="text-xs text-zinc-500"></span></div>
        <textarea data-random-output readonly class="min-h-80 w-full resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 font-mono text-sm leading-6 text-zinc-100 outline-none"></textarea>
        <div class="flex flex-wrap items-center gap-2">
          <button
            data-copy-random
            type="button"
            class="focus-ring min-w-24 rounded-xl border border-white/10 px-4 py-2.5 text-sm font-semibold text-zinc-200 transition duration-150 hover:-translate-y-0.5 hover:border-brand-400/50 hover:bg-brand-500/10 active:translate-y-0 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
          >
            Copy
          </button>

          <button
            data-download-random
            type="button"
            class="focus-ring min-w-36 rounded-xl border border-white/10 px-4 py-2.5 text-sm font-semibold text-zinc-200 transition duration-150 hover:-translate-y-0.5 hover:border-brand-400/50 hover:bg-brand-500/10 active:translate-y-0 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
          >
            Download TXT
          </button>

          <button
            data-clear-random
            type="button"
            class="focus-ring min-w-24 rounded-xl border border-white/10 px-4 py-2.5 text-sm font-semibold text-zinc-400 transition duration-150 hover:-translate-y-0.5 hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200 active:translate-y-0 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
          >
            Clear
          </button>

          <span
            data-random-action-status
            aria-live="polite"
            class="text-xs font-semibold text-brand-300"
          ></span>
        </div>
      </div>
    </div>
  </div>

  <div class:list={[mode === "random-text-generator" && "hidden"]}>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="grid min-w-0 grid-rows-[2.75rem_auto]">
        <div class="flex h-11 items-center">
          <span class="text-sm font-semibold text-zinc-200">Input</span>
        </div>

        <textarea
          data-convert-input
          class="h-[clamp(20rem,45vh,30rem)] min-h-80 w-full resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 font-mono text-sm leading-6 text-zinc-100 outline-none"
          placeholder="Enter content to convert..."
        ></textarea>
      </div>

      <div class="grid min-w-0 grid-rows-[2.75rem_auto]">
        <div class="flex h-11 items-center justify-between gap-3">
          <span class="text-sm font-semibold text-zinc-200">Output</span>

          <div class="flex flex-wrap items-center justify-end gap-2">
            <button
              data-copy-output
              type="button"
              disabled
              class="focus-ring min-w-20 rounded-xl border border-white/10 px-4 py-2 text-sm font-medium text-zinc-300 transition duration-150 hover:border-brand-400/40 hover:bg-brand-500/10 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
            >
              Copy
            </button>

            <button
              data-clear-converter
              type="button"
              disabled
              class="focus-ring min-w-20 rounded-xl border border-white/10 px-4 py-2 text-sm font-medium text-zinc-300 transition duration-150 hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
            >
              Clear
            </button>
          </div>
        </div>

        <textarea
          data-convert-output
          readonly
          class="h-[clamp(20rem,45vh,30rem)] min-h-80 w-full resize-y rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6 text-zinc-100 outline-none"
        ></textarea>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <button
        data-download-output
        type="button"
        disabled
        class="focus-ring rounded-xl border border-white/10 px-4 py-2.5 text-sm font-semibold text-zinc-200 transition duration-150 hover:border-brand-400/40 hover:bg-brand-500/10 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
      >
        Download
      </button>

      <span class="text-xs text-zinc-500">
        Output updates automatically as you type.
      </span>
    </div>
  </div>
</section>

<script>
  const esc = (s: string) => s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  const mdToHtml = (md: string) => {
    const inline = (s: string) => s.replace(/`([^`]+)`/g,"<code>$1</code>").replace(/\*\*([^*]+)\*\*/g,"<strong>$1</strong>").replace(/\*([^*]+)\*/g,"<em>$1</em>").replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,'<a href="$2" rel="noopener noreferrer">$1</a>');
    const out: string[] = []; let list = false;
    for (const raw of esc(md).split(/\r?\n/)) {
      const item = raw.match(/^\s*[-*+]\s+(.+)$/);
      if (item) {
        const itemText = item[1] ?? "";
        if (!list) {
          out.push("<ul>");
          list = true;
        }
        out.push(`<li>${inline(itemText)}</li>`);
        continue;
      }
      if (list) { out.push("</ul>"); list = false; }
      const h = raw.match(/^(#{1,6})\s+(.+)$/);
      if (h) {
        const marks = h[1] ?? "#";
        const headingText = h[2] ?? "";
        const level = marks.length;
        out.push(`<h${level}>${inline(headingText)}</h${level}>`);
      }
      else if (/^>\s?/.test(raw)) out.push(`<blockquote>${inline(raw.replace(/^>\s?/,""))}</blockquote>`);
      else if (raw.trim()) out.push(`<p>${inline(raw)}</p>`); else out.push("");
    }
    if (list) out.push("</ul>"); return out.join("\n");
  };
  const htmlToText = (html: string) => { const d = new DOMParser().parseFromString(html,"text/html"); d.querySelectorAll("script,style,noscript").forEach(n=>n.remove()); return (d.body.textContent ?? "").replace(/\n{3,}/g,"\n\n").trim(); };
  const htmlToMd = (html: string) => {
    const d = new DOMParser().parseFromString(html,"text/html"); d.querySelectorAll("script,style,noscript").forEach(n=>n.remove());
    const walk = (n: Node): string => { if (n.nodeType === Node.TEXT_NODE) return n.textContent ?? ""; if (!(n instanceof HTMLElement)) return ""; const c = Array.from(n.childNodes).map(walk).join(""); switch(n.tagName.toLowerCase()) { case "h1": return `# ${c}\n\n`; case "h2": return `## ${c}\n\n`; case "h3": return `### ${c}\n\n`; case "strong": case "b": return `**${c}**`; case "em": case "i": return `*${c}*`; case "code": return `\`${c}\``; case "a": return `[${c}](${n.getAttribute("href") ?? ""})`; case "li": return `- ${c.trim()}\n`; case "ul": case "ol": return `${c}\n`; case "blockquote": return `> ${c.trim()}\n\n`; case "br": return "\n"; case "p": case "div": return `${c.trim()}\n\n`; default: return c; } };
    return walk(d.body).replace(/\n{3,}/g,"\n\n").trim();
  };
  document.querySelectorAll<HTMLElement>("[data-content-tools]").forEach((root) => {
    const mode = root.dataset.mode ?? "";
    if (mode === "random-text-generator") {
      const output = root.querySelector<HTMLTextAreaElement>("[data-random-output]")!;
      const amount = root.querySelector<HTMLInputElement>("[data-random-amount]")!;
      const type = root.querySelector<HTMLSelectElement>("[data-random-type]")!;
      const separator = root.querySelector<HTMLInputElement>("[data-random-separator]")!;
      const stats = root.querySelector<HTMLElement>("[data-random-stats]")!;
      const limitMessage = root.querySelector<HTMLElement>("[data-random-limit]")!;
      const copyButton = root.querySelector<HTMLButtonElement>("[data-copy-random]")!;
      const downloadButton = root.querySelector<HTMLButtonElement>("[data-download-random]")!;
      const clearButton = root.querySelector<HTMLButtonElement>("[data-clear-random]")!;
      const actionStatus = root.querySelector<HTMLElement>("[data-random-action-status]")!;
      const words=["bright","quiet","forest","river","signal","window","simple","purple","future","cloud","gentle","system","creative","journey","useful","modern","stable","rapid","quality","open"], emojis=["✨","🚀","🌿","📦","💡","🎯","✅","🌙","⚡","🧩"], specials=["!","@","#","$","%","&","*","+","=","?"];
      const checked=(n:string)=>root.querySelector<HTMLInputElement>(`[data-random-option="${n}"]`)?.checked ?? false; const pick = <T,>(items: readonly T[]): T => {
        const item = items[Math.floor(Math.random() * items.length)];
        if (item === undefined) {
          throw new Error("Cannot select a random item from an empty list.");
        }
        return item;
      };
      const word=()=>{ let v=pick(words); if(checked("uppercase")&&Math.random()>.75)v=v.toUpperCase(); if(checked("numbers")&&Math.random()>.72)v+=Math.floor(Math.random()*1000); if(checked("emoji")&&Math.random()>.82)v+=pick(emojis); if(checked("special")&&Math.random()>.78)v+=pick(specials); return v; };
      const sentence = () => {
        const value = Array.from(
          { length: 6 + Math.floor(Math.random() * 8) },
          word,
        ).join(" ");

        const firstCharacter = value.charAt(0).toUpperCase();
        return firstCharacter + value.slice(1) + pick([".", ".", "!", "?"]);
      };
      const limits: Record<string, number> = {
        words: 50000,
        sentences: 5000,
        paragraphs: 500,
        mixed: 20000,
      };

      const amountLabels: Record<string, string> = {
        words: "words",
        sentences: "sentences",
        paragraphs: "paragraphs",
        mixed: "items",
      };

      const normalNoticeClasses =
        "rounded-xl border border-brand-400/30 bg-brand-500/10 px-3 py-2 text-xs font-semibold leading-5 text-brand-200";

      const warningNoticeClasses =
        "rounded-xl border border-brand-300/60 bg-brand-500/20 px-3 py-2 text-xs font-bold leading-5 text-brand-100";

      const updateLimit = () => {
        const maximum = limits[type.value] ?? 500;
        const label = amountLabels[type.value] ?? "items";

        amount.max = String(maximum);
        limitMessage.className = normalNoticeClasses;
        limitMessage.textContent =
          `Maximum: ${maximum.toLocaleString()} ${label}`;
      };

      const updateStats = () => {
        const currentText = output.value;
        const trimmedText = currentText.trim();

        const wordCount =
          trimmedText.length > 0
            ? trimmedText.split(/\s+/u).filter(Boolean).length
            : 0;

        const characterCount = Array.from(currentText).length;

        stats.textContent =
          `${wordCount.toLocaleString()} words · ` +
          `${characterCount.toLocaleString()} characters`;

        const hasOutput = currentText.length > 0;
        copyButton.disabled = !hasOutput;
        downloadButton.disabled = !hasOutput;
        clearButton.disabled = !hasOutput;
      };

      const generate = () => {
        const maximum = limits[type.value] ?? 500;
        const label = amountLabels[type.value] ?? "items";
        const rawAmount = amount.value.trim();
        const enteredAmount = Number(rawAmount);

        const exceedsLimit =
          rawAmount.length > 0 &&
          (!Number.isFinite(enteredAmount) || enteredAmount > maximum);

        const count = exceedsLimit
          ? maximum
          : Math.max(
              1,
              Math.min(
                maximum,
                Math.floor(
                  Number.isFinite(enteredAmount) ? enteredAmount : 1,
                ),
              ),
            );

        amount.value = String(count);

        if (exceedsLimit) {
          limitMessage.className = warningNoticeClasses;
          limitMessage.textContent =
            `Limited to ${maximum.toLocaleString()} ${label} to keep the browser responsive.`;
        } else {
          updateLimit();
        }

        let result = "";

        if (type.value === "words") {
          result = Array.from({ length: count }, word).join(
            separator.value || " ",
          );
        } else if (type.value === "sentences") {
          result = Array.from({ length: count }, sentence).join(
            checked("lineBreaks") ? "\n" : " ",
          );
        } else if (type.value === "paragraphs") {
          result = Array.from(
            { length: count },
            () =>
              Array.from(
                { length: 3 + Math.floor(Math.random() * 4) },
                sentence,
              ).join(" "),
          ).join(checked("lineBreaks") ? "\n\n" : " ");
        } else {
          result = Array.from(
            { length: count },
            () =>
              [
                word(),
                word(),
                checked("numbers")
                  ? String(Math.floor(Math.random() * 100000))
                  : "",
                checked("emoji") ? pick(emojis) : "",
                checked("special") ? pick(specials) : "",
              ]
                .filter(Boolean)
                .join(separator.value || " "),
          ).join(checked("lineBreaks") ? "\n" : " ");
        }

        output.value = result;
        updateStats();
      };

      type.addEventListener("change", () => {
        updateLimit();
        generate();
      });

      root.querySelector("[data-generate]")?.addEventListener("click", generate);
      const showActionFeedback = (
        button: HTMLButtonElement,
        message: string,
        temporaryLabel: string,
      ) => {
        const originalLabel = button.dataset.originalLabel ?? button.textContent ?? "";
        button.dataset.originalLabel = originalLabel;

        button.textContent = temporaryLabel;
        button.classList.add(
          "border-brand-400/60",
          "bg-brand-500/20",
          "text-brand-100",
          "scale-[0.98]",
        );

        actionStatus.textContent = message;

        window.setTimeout(() => {
          button.textContent = originalLabel;
          button.classList.remove(
            "border-brand-400/60",
            "bg-brand-500/20",
            "text-brand-100",
            "scale-[0.98]",
          );

          if (actionStatus.textContent === message) {
            actionStatus.textContent = "";
          }
        }, 1200);
      };

      copyButton.addEventListener("click", async () => {
        if (!output.value) return;

        try {
          await navigator.clipboard.writeText(output.value);
          showActionFeedback(copyButton, "Text copied to clipboard.", "Copied!");
        } catch {
          actionStatus.textContent = "Copy failed. Please try again.";
        }
      });

      downloadButton.addEventListener("click", () => {
        if (!output.value) return;

        const url = URL.createObjectURL(
          new Blob([output.value], {
            type: "text/plain;charset=utf-8",
          }),
        );

        const link = document.createElement("a");
        link.href = url;
        link.download = "random-text.txt";
        link.click();
        URL.revokeObjectURL(url);

        showActionFeedback(
          downloadButton,
          "TXT file downloaded.",
          "Downloaded!",
        );
      });

      clearButton.addEventListener("click", () => {
        if (!output.value) return;

        output.value = "";
        updateStats();
        updateLimit();

        showActionFeedback(clearButton, "Generated text cleared.", "Cleared");
      });

      updateLimit();
      generate();
      return;
    }
    const input =
      root.querySelector<HTMLTextAreaElement>("[data-convert-input]")!;
    const output =
      root.querySelector<HTMLTextAreaElement>("[data-convert-output]")!;
    const copyButton =
      root.querySelector<HTMLButtonElement>("[data-copy-output]")!;
    const clearButton =
      root.querySelector<HTMLButtonElement>("[data-clear-converter]")!;
    const downloadButton =
      root.querySelector<HTMLButtonElement>("[data-download-output]")!;

    const fileExtensions: Record<string, string> = {
      "markdown-to-html": "html",
      "html-to-markdown": "md",
      "markdown-to-plain-text": "txt",
    };

    const updateActions = () => {
      const hasInput = input.value.length > 0;
      const hasOutput = output.value.length > 0;

      copyButton.disabled = !hasOutput;
      clearButton.disabled = !hasInput && !hasOutput;
      downloadButton.disabled = !hasOutput;
    };

    const convert = () => {
      const value = input.value;

      if (!value) {
        output.value = "";
        updateActions();
        return;
      }

      if (mode === "markdown-to-html") {
        output.value = mdToHtml(value);
      } else if (mode === "html-to-markdown") {
        output.value = htmlToMd(value);
      } else if (mode === "markdown-to-plain-text") {
        output.value = htmlToText(mdToHtml(value));
      } else {
        output.value = value;
      }

      updateActions();
    };

    input.addEventListener("input", convert);

    copyButton.addEventListener("click", async () => {
      if (!output.value) return;

      try {
        await navigator.clipboard.writeText(output.value);
      } catch {
        return;
      }
    });

    clearButton.addEventListener("click", () => {
      input.value = "";
      output.value = "";
      updateActions();
      input.focus();
    });

    downloadButton.addEventListener("click", () => {
      if (!output.value) return;

      const extension = fileExtensions[mode] ?? "txt";
      const mimeType =
        extension === "html"
          ? "text/html;charset=utf-8"
          : "text/plain;charset=utf-8";

      const url = URL.createObjectURL(
        new Blob([output.value], {
          type: mimeType,
        }),
      );

      const link = document.createElement("a");
      link.href = url;
      link.download = `converted.${extension}`;
      link.click();

      URL.revokeObjectURL(url);
    });

    convert();
  });
</script>
