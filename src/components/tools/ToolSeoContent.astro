---
import type { ToolDefinition } from "@/types/tool";
import { getToolContentSections } from "@/data/toolSeoContent";

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const sections = getToolContentSections(tool);
---

<section class="mt-12 border-t border-white/10 pt-10" aria-labelledby="tool-guide-heading">
  <div class="max-w-5xl">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-300">Tool guide</p>
    <h2 id="tool-guide-heading" class="mt-2 text-2xl font-bold text-white">
      About {tool.name}
    </h2>
  </div>

  <div class="mt-6 grid gap-x-10 gap-y-8 lg:grid-cols-2">
    {sections.map((section) => (
      <section>
        <h3 class="text-lg font-bold text-white">{section.heading}</h3>
        <div class="mt-3 space-y-3 text-sm leading-7 text-zinc-400">
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    ))}
  </div>
</section>
