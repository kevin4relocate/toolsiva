---
interface Props { mode: string; }
const { mode } = Astro.props;
---
<section class="rounded-2xl border border-white/10 bg-zinc-900/80 p-4 shadow-xl shadow-black/20 sm:p-5" data-converter data-mode={mode}>
 <div class="grid gap-4 lg:grid-cols-[1fr_auto_1fr] lg:items-end">
  <label class="grid gap-1.5"><span class="text-xs font-medium text-zinc-400">From</span><div class="grid grid-cols-[1fr_auto] gap-2"><input data-input aria-label="Value to convert" type="number" step="any" value="1" class="min-w-0 rounded-xl border border-white/10 bg-zinc-950 px-3 py-3 text-sm text-white"/><select data-from aria-label="Source unit" class="rounded-xl border border-white/10 bg-zinc-950 px-3 py-3 text-sm text-white"></select></div></label>
  <button data-swap type="button" class="cursor-pointer rounded-xl border border-white/10 px-3 py-3 text-sm text-zinc-300 hover:bg-white/5" aria-label="Swap units">⇄</button>
  <label class="grid gap-1.5"><span class="text-xs font-medium text-zinc-400">To</span><div class="grid grid-cols-[1fr_auto] gap-2"><output data-output role="status" aria-live="polite" aria-atomic="true" class="min-w-0 overflow-x-auto rounded-xl border border-white/10 bg-zinc-950 px-3 py-3 text-sm font-semibold text-white">—</output><select data-to aria-label="Destination unit" class="rounded-xl border border-white/10 bg-zinc-950 px-3 py-3 text-sm text-white"></select></div></label>
 </div><p data-formula class="mt-3 text-xs text-zinc-500"></p>
</section>
<script>
  import { unitSets, convertToolValue } from "@/lib/converterEngine";

  document.querySelectorAll<HTMLElement>("[data-converter]").forEach((root) => {
    const mode = root.dataset.mode ?? "";
    const units = unitSets[mode];
    const input = root.querySelector<HTMLInputElement>("[data-input]");
    const from = root.querySelector<HTMLSelectElement>("[data-from]");
    const to = root.querySelector<HTMLSelectElement>("[data-to]");
    const output = root.querySelector<HTMLOutputElement>("[data-output]");
    const formula = root.querySelector<HTMLElement>("[data-formula]");
    if (!units || !input || !from || !to || !output) return;

    Object.entries(units).forEach(([key, unit]) => {
      from.add(new Option(unit.label, key));
      to.add(new Option(unit.label, key));
    });
    to.selectedIndex = Math.min(1, to.options.length - 1);

    const update = () => {
      const result = convertToolValue(mode, input.value, from.value, to.value);
      if (result.error || result.value === null) {
        output.textContent = "—";
        if (formula) formula.textContent = result.error ?? "Invalid input.";
        return;
      }
      const source = units[from.value];
      const target = units[to.value];
      if (!source || !target) return;
      output.textContent = result.value.toLocaleString("en-US", { maximumSignificantDigits: 12 });
      if (formula) formula.textContent = input.value + " " + source.label + " = " + output.textContent + " " + target.label;
    };
    root.addEventListener("input", update);
    root.addEventListener("change", update);
    root.querySelector("[data-swap]")?.addEventListener("click", () => {
      const previous = from.value;
      from.value = to.value;
      to.value = previous;
      update();
    });
    update();
  });
</script>
