---
interface Props { mode: string; }
const { mode } = Astro.props;
---

<section class="rounded-2xl border border-white/10 bg-white/[0.02] p-4 sm:p-5" data-new-text-tool data-mode={mode}>
  <div class="grid gap-4 lg:grid-cols-2">
    <div class="grid min-w-0 grid-rows-[2.75rem_auto_auto]">
      <div class="flex h-11 items-center"><label class="block text-sm font-semibold text-zinc-200">Input</label></div>
      <textarea data-input rows="12" class="h-[clamp(18rem,42vh,26rem)] min-h-72 w-full resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 font-mono text-sm leading-6 text-zinc-100 outline-none transition focus:border-brand-400/50" placeholder="Enter or paste text here..."></textarea>
      <div data-options class="mt-3 flex flex-wrap gap-3"></div>
    </div>
    <div class="grid min-w-0 grid-rows-[2.75rem_auto_auto]">
      <div class="flex h-11 items-center justify-between gap-3">
        <label class="text-sm font-semibold text-zinc-200">Result</label>
        <button type="button" data-copy class="focus-ring cursor-pointer rounded-lg border border-white/10 px-3 py-1.5 text-xs font-semibold text-zinc-300 transition hover:border-brand-400/40 hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-50">Copy</button>
      </div>
      <textarea data-output rows="12" readonly class="h-[clamp(18rem,42vh,26rem)] min-h-72 w-full resize-y rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6 text-zinc-100 outline-none" placeholder="Result appears automatically..."></textarea>
      <div data-stats class="mt-3 grid gap-2 sm:grid-cols-3"></div>
    </div>
  </div>
</section>

<script>
  const escapeHtml = (text: string) => {
    const element = document.createElement("div");
    element.textContent = text;
    return element.innerHTML;
  };

  document.querySelectorAll<HTMLElement>("[data-new-text-tool]").forEach((root) => {
    const mode = root.dataset.mode ?? "";
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
    const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
    const options = root.querySelector<HTMLElement>("[data-options]");
    const stats = root.querySelector<HTMLElement>("[data-stats]");
    const copy = root.querySelector<HTMLButtonElement>("[data-copy]");

    if (!input || !output || !options || !stats || !copy) return;

    if (mode === "add-bullets-to-text") {
      options.innerHTML = `
        <label class="text-xs text-zinc-400">Bullet
          <select data-opt="bullet" class="ml-2 rounded-lg border border-white/10 bg-zinc-950 px-2 py-1.5">
            <option value="-">-</option><option value="•">•</option><option value="◦">◦</option>
            <option value="▪">▪</option><option value="✓">✓</option><option value="→">→</option><option value="*">*</option>
          </select>
        </label>
        <label class="text-xs text-zinc-400">Custom
          <input data-opt="customBullet" placeholder="Optional" class="ml-2 w-28 rounded-lg border border-white/10 bg-zinc-950 px-2 py-1.5">
        </label>`;
    }

    if (mode === "add-blank-lines-between-text") {
      options.innerHTML = `
        <label class="text-xs text-zinc-400">Blank lines
          <input data-opt="blankCount" type="number" min="0" max="20" value="1" class="ml-2 w-20 rounded-lg border border-white/10 bg-zinc-950 px-2 py-1.5">
        </label>`;
    }

    if (mode === "add-prefix-suffix-to-lines") {
      options.innerHTML = `
        <label class="text-xs text-zinc-400">Prefix
          <input data-opt="prefix" class="ml-2 w-28 rounded-lg border border-white/10 bg-zinc-950 px-2 py-1.5">
        </label>
        <label class="text-xs text-zinc-400">Suffix
          <input data-opt="suffix" class="ml-2 w-28 rounded-lg border border-white/10 bg-zinc-950 px-2 py-1.5">
        </label>`;
    }

    if (mode === "quote-each-line") {
      options.innerHTML = `
        <label class="text-xs text-zinc-400">Quote
          <select data-opt="quoteStyle" class="ml-2 rounded-lg border border-white/10 bg-zinc-950 px-2 py-1.5">
            <option value="double">Double</option><option value="single">Single</option><option value="backtick">Backtick</option>
          </select>
        </label>`;
    }

    if (mode === "extract-emails-from-text" || mode === "extract-urls-from-text") {
      options.innerHTML = `<label class="text-xs text-zinc-400"><input data-opt="uniqueOnly" type="checkbox" checked class="mr-1.5">Remove duplicates</label>`;
    }

    const opt = (key: string, fallback = "") =>
      root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-opt="${key}"]`)?.value ?? fallback;

    const checked = (key: string, fallback = false) =>
      root.querySelector<HTMLInputElement>(`[data-opt="${key}"]`)?.checked ?? fallback;

    const update = () => {
      const text = input.value;
      const lines = text.split(/\r?\n/);
      let result = text;
      const metrics: Array<[string, string]> = [];

      if (mode === "add-bullets-to-text") {
        const bullet = opt("customBullet") || opt("bullet", "-");
        result = lines.map((line) => line.trim() ? `${bullet} ${line}` : line).join("\n");
        metrics.push(["Lines formatted", String(lines.filter((line) => line.trim()).length)]);
      }

      if (mode === "add-blank-lines-between-text") {
        const count = Math.min(20, Math.max(0, Number.parseInt(opt("blankCount", "1"), 10) || 0));
        result = lines.join("\n".repeat(count + 1));
        metrics.push(["Blank lines", String(count)]);
      }

      if (mode === "add-prefix-suffix-to-lines") {
        const prefix = opt("prefix");
        const suffix = opt("suffix");
        result = lines.map((line) => line.trim() ? `${prefix}${line}${suffix}` : line).join("\n");
      }

      if (mode === "trim-each-line") {
        result = lines.map((line) => line.trim()).join("\n");
        metrics.push(["Characters removed", String(Math.max(0, text.length - result.length))]);
      }

      if (mode === "quote-each-line") {
        const style = opt("quoteStyle", "double");
        const quote = style === "single" ? "'" : style === "backtick" ? "`" : '"';
        result = lines.map((line) => `${quote}${line}${quote}`).join("\n");
      }

      if (mode === "remove-line-numbers") {
        result = lines.map((line) => line.replace(/^\s*(?:\d+[.)\]:-]|\(\d+\))\s*/, "")).join("\n");
      }

      if (mode === "extract-emails-from-text") {
        let items: string[] = text.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi) ?? [];
        if (checked("uniqueOnly", true)) items = [...new Set(items.map((item) => item.toLowerCase()))];
        result = items.join("\n");
        metrics.push(["Emails found", String(items.length)]);
      }

      if (mode === "extract-urls-from-text") {
        let items: string[] = text.match(/(?:https?:\/\/|www\.)[^\s<>"']+/gi) ?? [];
        items = items.map((item) => item.replace(/[),.;!?]+$/, ""));
        if (checked("uniqueOnly", true)) items = [...new Set(items)];
        result = items.join("\n");
        metrics.push(["URLs found", String(items.length)]);
      }

      output.value = result;
      copy.disabled = !result;
      stats.innerHTML = metrics.map(([label, value]) =>
        `<div class="rounded-xl border border-white/10 p-3"><strong class="block text-lg text-white">${escapeHtml(value)}</strong><span class="text-xs text-zinc-500">${escapeHtml(label)}</span></div>`
      ).join("");
    };

    input.addEventListener("input", update);
    options.addEventListener("input", update);
    options.addEventListener("change", update);
    copy.addEventListener("click", async () => {
      await navigator.clipboard.writeText(output.value);
      copy.textContent = "Copied";
      window.setTimeout(() => { copy.textContent = "Copy"; }, 900);
    });

    update();
  });
</script>
