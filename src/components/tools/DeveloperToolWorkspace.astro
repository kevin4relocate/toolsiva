---
interface Props { mode: string; }
const { mode } = Astro.props;
const isValidator = mode.endsWith("-validator");
const isGenerator = mode === "uuid-generator";
---
<section class="overflow-hidden rounded-3xl border border-white/10 bg-zinc-900/80 shadow-2xl shadow-black/20" data-developer-tool data-mode={mode} data-validator={isValidator ? "true" : "false"} data-generator={isGenerator ? "true" : "false"}>
  <div class="p-4 sm:p-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-zinc-500">{isGenerator ? "Generated locally in your browser." : "Updates automatically in your browser."}</p>
      <div class="flex flex-wrap items-center gap-2">
        <span data-status class="min-w-24 text-right text-sm font-medium text-emerald-400 opacity-0 transition-opacity" aria-live="polite"></span>
        {isGenerator && <button type="button" data-generate class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">Generate UUIDs</button>}
        <button type="button" data-copy class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-brand-400/40 hover:bg-white/5">Copy result</button>
        <button type="button" data-clear class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200">Clear</button>
      </div>
    </div>

    {isGenerator ? (
      <label class="grid max-w-xs gap-2 text-sm text-zinc-300">Number of UUIDs<input data-count type="number" min="1" max="100" value="1" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-zinc-100" /></label>
    ) : (
      <label class="grid gap-2 text-sm text-zinc-300">Input<textarea data-input class="focus-ring min-h-72 w-full resize-y rounded-2xl border border-white/10 bg-zinc-950 p-5 font-mono text-sm leading-7 text-zinc-100" placeholder="Paste your text, code or data here…" spellcheck="false"></textarea></label>
    )}

    <div class="mt-4">
      {isValidator ? (
        <div class="grid gap-2 text-sm text-zinc-300">Validation result<div data-compact-result class="min-h-16 whitespace-pre-wrap rounded-2xl border border-white/10 bg-zinc-950/70 px-5 py-4 font-mono text-sm leading-6 text-zinc-400">Enter data to validate.</div><textarea data-output class="hidden" readonly></textarea></div>
      ) : (
        <label class="grid gap-2 text-sm text-zinc-300">Result<textarea data-output readonly class="focus-ring min-h-56 w-full resize-y rounded-2xl border border-white/10 bg-zinc-950/70 p-5 font-mono text-sm leading-7 text-zinc-100"></textarea></label>
      )}
    </div>

    <div class="mt-3 flex justify-end gap-2">
      {isGenerator && <button type="button" data-generate class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">Generate UUIDs</button>}
      <button type="button" data-copy class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-brand-400/40 hover:bg-white/5">Copy result</button>
      <button type="button" data-clear class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200">Clear</button>
    </div>
  </div>
</section>

<script>
  import { parseAllDocuments } from "yaml";
  const escapeXml = (v:string) => v.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&apos;");
  const safeName = (v:string) => { const x=v.replace(/[^A-Za-z0-9_.-]/g,"_"); return /^[A-Za-z_]/.test(x)?x:`item_${x}`; };
  const toXml = (v:unknown,n="root",l=0):string => { const i="  ".repeat(l),t=safeName(n); if(Array.isArray(v)){const c=v.map(x=>toXml(x,"item",l+1)).join("\n");return `${i}<${t}>${c?`\n${c}\n${i}`:""}</${t}>`;} if(v!==null&&typeof v==="object"){const c=Object.entries(v as Record<string,unknown>).map(([k,x])=>toXml(x,k,l+1)).join("\n");return `${i}<${t}>${c?`\n${c}\n${i}`:""}</${t}>`;} return v===null?`${i}<${t} />`:`${i}<${t}>${escapeXml(String(v))}</${t}>`; };
  const scalar=(v:unknown)=>v===null?"null":typeof v==="boolean"||typeof v==="number"?String(v):JSON.stringify(String(v));
  const toYaml=(v:unknown,l=0):string=>{const i="  ".repeat(l);if(Array.isArray(v))return v.length?v.map(x=>x!==null&&typeof x==="object"?`${i}-\n${toYaml(x,l+1)}`:`${i}- ${scalar(x)}`).join("\n"):`${i}[]`;if(v!==null&&typeof v==="object")return Object.entries(v as Record<string,unknown>).map(([k,x])=>x!==null&&typeof x==="object"?`${i}${k}:\n${toYaml(x,l+1)}`:`${i}${k}: ${scalar(x)}`).join("\n")||`${i}{}`;return `${i}${scalar(v)}`;};
  const csv=(v:unknown)=>{if(!Array.isArray(v)||v.some(x=>x===null||Array.isArray(x)||typeof x!=="object"))throw new Error("Expected a JSON array of objects.");const rows=v as Record<string,unknown>[],heads=[...new Set(rows.flatMap(r=>Object.keys(r)))];const cell=(x:unknown)=>`"${(x!==null&&typeof x==="object"?JSON.stringify(x):String(x??"")).replace(/"/g,'""')}"`;return [heads.map(cell).join(","),...rows.map(r=>heads.map(h=>cell(r[h])).join(","))].join("\n");};
  const b64e=(v:string)=>{const bytes=new TextEncoder().encode(v);let b="";bytes.forEach(x=>b+=String.fromCharCode(x));return btoa(b);};
  const b64d=(v:string)=>new TextDecoder("utf-8",{fatal:true}).decode(Uint8Array.from(atob(v.replace(/\s+/g,"")),c=>c.charCodeAt(0)));
  const htmlEncode=(v:string)=>v.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
  const htmlDecode=(v:string)=>{const t=document.createElement("textarea");t.innerHTML=v;return t.value;};
  const parseXml=(v:string)=>{const d=new DOMParser().parseFromString(v,"application/xml"),e=d.querySelector("parsererror")??Array.from(d.getElementsByTagNameNS("*","parsererror"))[0];if(e)throw new Error(e.textContent?.replace(/\s+/g," ").trim()||"Invalid XML.");return d;};
  const formatXml=(v:string)=>{const s=new XMLSerializer().serializeToString(parseXml(v));const tokens=s.replace(/>\s*</g,"><").replace(/</g,"\n<").trim().split("\n");let l=0;return tokens.map(t=>{if(/^<\//.test(t))l=Math.max(0,l-1);const line=`${"  ".repeat(l)}${t}`;if(/^<[^!?/][^>]*[^/]?>$/.test(t)&&!/<\/[^>]+>$/.test(t))l++;return line;}).join("\n");};
  const timestamp=(v:string)=>{const t=v.trim();if(!t)throw new Error("Enter a timestamp or date.");const d=/^-?\d+(\.\d+)?$/.test(t)?new Date(Math.abs(Number(t))<1e12?Number(t)*1000:Number(t)):new Date(t);if(Number.isNaN(d.getTime()))throw new Error("Invalid date or timestamp.");return `ISO: ${d.toISOString()}\nUTC: ${d.toUTCString()}\nLocal: ${d.toLocaleString()}\nSeconds: ${Math.floor(d.getTime()/1000)}\nMilliseconds: ${d.getTime()}`;};
  function setup(){document.querySelectorAll<HTMLElement>("[data-developer-tool]").forEach(root=>{if(root.dataset.initialized==="true")return;root.dataset.initialized="true";const mode=root.dataset.mode??"",generator=root.dataset.generator==="true";const input=root.querySelector<HTMLTextAreaElement>("[data-input]"),output=root.querySelector<HTMLTextAreaElement>("[data-output]"),compact=root.querySelector<HTMLElement>("[data-compact-result]"),count=root.querySelector<HTMLInputElement>("[data-count]");const generate=root.querySelectorAll<HTMLButtonElement>("[data-generate]"),copies=root.querySelectorAll<HTMLButtonElement>("[data-copy]"),clears=root.querySelectorAll<HTMLButtonElement>("[data-clear]"),status=root.querySelector<HTMLElement>("[data-status]");let timer: ReturnType<typeof setTimeout> | undefined; let debounce: ReturnType<typeof setTimeout> | undefined;
    const notify=(m:string,bad=false)=>{if(!status)return;status.textContent=m;status.classList.toggle("text-red-400",bad);status.classList.toggle("text-emerald-400",!bad);status.classList.replace("opacity-0","opacity-100");if (timer) clearTimeout(timer); timer=setTimeout(()=>status.classList.replace("opacity-100","opacity-0"),1300);};
    const setResult=(v:string,bad=false)=>{if(output)output.value=v;if(compact){compact.textContent=v||"Enter data to validate.";compact.classList.toggle("text-red-300",bad);compact.classList.toggle("text-emerald-300",!bad&&!!v);compact.classList.toggle("text-zinc-400",!v);}};
    const transform=()=>{const v=input?.value??"";if(!generator&&!v){setResult("");return;}try{let r="";switch(mode){case"json-formatter":r=JSON.stringify(JSON.parse(v),null,2);break;case"json-validator":JSON.parse(v);r="Valid JSON";break;case"json-minifier":r=JSON.stringify(JSON.parse(v));break;case"json-escape":r=JSON.stringify(v).slice(1,-1);break;case"json-unescape":r=JSON.parse(v.startsWith('"')&&v.endsWith('"')?v:`"${v.replace(/\\/g,"\\\\").replace(/"/g,'\\"')}"`);break;case"json-to-csv":r=csv(JSON.parse(v));break;case"json-to-xml":r=`<?xml version="1.0" encoding="UTF-8"?>\n${toXml(JSON.parse(v))}`;break;case"json-to-yaml":r=toYaml(JSON.parse(v));break;case"base64-encode":r=b64e(v);break;case"base64-decode":r=b64d(v);break;case"url-encode":r=encodeURIComponent(v);break;case"url-decode":r=decodeURIComponent(v.replace(/\+/g," "));break;case"html-encode":r=htmlEncode(v);break;case"html-decode":r=htmlDecode(v);break;case"xml-formatter":r=formatXml(v);break;case"xml-validator":parseXml(v);r="Valid well-formed XML";break;case"yaml-validator":{const docs=parseAllDocuments(v,{prettyErrors:true,strict:true,uniqueKeys:true});const errors=docs.flatMap(d=>d.errors);if(errors.length)throw new Error(errors.map(e=>e.message).join("\n"));r=docs.length>1?`Valid YAML stream (${docs.length} documents)`:"Valid YAML";break;}case"jwt-decoder":{const p=v.trim().split(".");if(p.length<2)throw new Error("A JWT must contain a header and payload.");const dec=(x:string)=>JSON.parse(b64d(x.replace(/-/g,"+").replace(/_/g,"/").padEnd(Math.ceil(x.length/4)*4,"=")));r=`Header:\n${JSON.stringify(dec(p[0]??""),null,2)}\n\nPayload:\n${JSON.stringify(dec(p[1]??""),null,2)}\n\nWarning: signature not verified.`;break;}case"unix-timestamp-converter":r=timestamp(v);break;}setResult(r); }catch(e){setResult(e instanceof Error?e.message:"Unable to process input.",true);}};
    input?.addEventListener("input",()=>{if (debounce) clearTimeout(debounce); debounce=setTimeout(transform,180);});
    generate.forEach(b=>b.addEventListener("click",()=>{const n=Number.parseInt(count?.value??"1",10);if(!Number.isInteger(n)||n<1||n>100)return notify("Enter 1 to 100",true);setResult(Array.from({length:n},()=>crypto.randomUUID()).join("\n"));notify("Generated");}));
    copies.forEach(b=>b.addEventListener("click",async()=>{if(!output?.value)return notify("Nothing to copy",true);await navigator.clipboard.writeText(output.value);notify("Copied");}));
    clears.forEach(b=>b.addEventListener("click",()=>{if(input)input.value="";if(output)output.value="";setResult("");notify("Cleared");}));
  });}
  setup();document.addEventListener("astro:page-load",setup);
</script>
