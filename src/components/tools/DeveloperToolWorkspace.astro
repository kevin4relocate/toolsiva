---
interface Props { mode: string; }
const { mode } = Astro.props;
const validators = new Set(["json-validator","xml-validator","yaml-validator"]);
const isValidator = validators.has(mode);
const isGenerator = mode === "uuid-generator";
const dualPane = !isValidator && !isGenerator;
---
<section class="overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/80 shadow-xl shadow-black/20" data-developer-tool data-mode={mode} data-validator={isValidator ? "true" : "false"} data-generator={isGenerator ? "true" : "false"}>
  <div class="p-3 sm:p-4">
    <div class="mb-2.5 flex flex-wrap items-center justify-between gap-2.5">
      <p class="text-sm text-zinc-500">{isGenerator ? "Generated locally in your browser." : "Updates automatically in your browser."}</p>
      <div class="flex flex-wrap items-center gap-2"><span data-status class="min-w-20 text-right text-sm font-medium text-emerald-400 opacity-0 transition-opacity" aria-live="polite"></span>{isGenerator && <button type="button" data-generate class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">Generate UUIDs</button>}<button type="button" data-copy class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:bg-white/5">Copy result</button><button type="button" data-clear class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-red-400/40 hover:bg-red-500/10">Clear</button></div>
    </div>

    {isGenerator && <label class="grid max-w-xs gap-2 text-sm text-zinc-300">Number of UUIDs<input data-count type="number" min="1" max="100" value="1" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3" /></label>}

    {isValidator && (
      <>
        <label class="grid gap-2 text-sm text-zinc-300">Editor<textarea data-input class="focus-ring min-h-[clamp(14rem,38vh,24rem)] w-full resize-y rounded-2xl border border-white/10 bg-zinc-950 p-5 font-mono text-sm leading-7 text-zinc-100" placeholder="Paste data to validate…" spellcheck="false"></textarea></label>
        <div data-validation-card class="mt-4 rounded-2xl border border-white/10 bg-zinc-950/60 p-5 text-zinc-400">
          <div class="flex flex-wrap items-center justify-between gap-3"><div><strong data-validation-title class="block text-base text-zinc-200">Waiting for input</strong><span data-validation-location class="mt-1 block text-sm text-zinc-500"></span></div><button type="button" data-go-error class="hidden rounded-lg border border-red-400/30 px-3 py-2 text-sm text-red-200 hover:bg-red-500/10">Go to error</button></div>
          <p data-validation-message class="mt-3 whitespace-pre-wrap font-mono text-sm leading-6">Paste JSON, XML or YAML to validate.</p>
          <pre data-error-preview class="mt-4 hidden overflow-auto rounded-xl border border-red-400/20 bg-black/25 p-4 text-sm leading-6"></pre>
        </div>
        <textarea data-output class="hidden" readonly></textarea>
      </>
    )}

    {dualPane && (
      <div class="grid gap-4 lg:grid-cols-2">
        <label class="grid gap-2 text-sm text-zinc-300">Input<textarea data-input class="focus-ring min-h-[clamp(14rem,38vh,24rem)] resize-y rounded-2xl border border-white/10 bg-zinc-950 p-5 font-mono text-sm leading-7 text-zinc-100" placeholder="Paste input…" spellcheck="false"></textarea></label>
        <label class="grid gap-2 text-sm text-zinc-300">Result<textarea data-output readonly class="focus-ring min-h-[clamp(14rem,38vh,24rem)] resize-y rounded-2xl border border-white/10 bg-zinc-950/70 p-5 font-mono text-sm leading-7 text-zinc-100"></textarea></label>
      </div>
    )}
  </div>
</section>

<script>
  import { parseAllDocuments } from "yaml";
  const xmlEscape=(v:string)=>v.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&apos;");
  const safeName=(v:string)=>{const x=v.replace(/[^A-Za-z0-9_.-]/g,"_");return /^[A-Za-z_]/.test(x)?x:`item_${x}`;};
  const toXml=(v:unknown,n="root",l=0):string=>{const i="  ".repeat(l),t=safeName(n);if(Array.isArray(v)){const c=v.map(x=>toXml(x,"item",l+1)).join("\n");return `${i}<${t}>${c?`\n${c}\n${i}`:""}</${t}>`;}if(v!==null&&typeof v==="object"){const c=Object.entries(v as Record<string,unknown>).map(([k,x])=>toXml(x,k,l+1)).join("\n");return `${i}<${t}>${c?`\n${c}\n${i}`:""}</${t}>`;}return v===null?`${i}<${t} />`:`${i}<${t}>${xmlEscape(String(v))}</${t}>`;};
  const scalar=(v:unknown)=>v===null?"null":typeof v==="boolean"||typeof v==="number"?String(v):JSON.stringify(String(v));
  const toYaml=(v:unknown,l=0):string=>{const i="  ".repeat(l);if(Array.isArray(v))return v.length?v.map(x=>x!==null&&typeof x==="object"?`${i}-\n${toYaml(x,l+1)}`:`${i}- ${scalar(x)}`).join("\n"):`${i}[]`;if(v!==null&&typeof v==="object")return Object.entries(v as Record<string,unknown>).map(([k,x])=>x!==null&&typeof x==="object"?`${i}${k}:\n${toYaml(x,l+1)}`:`${i}${k}: ${scalar(x)}`).join("\n")||`${i}{}`;return `${i}${scalar(v)}`;};
  const csv=(v:unknown)=>{if(!Array.isArray(v)||v.some(x=>x===null||Array.isArray(x)||typeof x!=="object"))throw new Error("Expected a JSON array of objects.");const rows=v as Record<string,unknown>[],heads=[...new Set(rows.flatMap(r=>Object.keys(r)))];const cell=(x:unknown)=>`"${(x!==null&&typeof x==="object"?JSON.stringify(x):String(x??"")).replace(/"/g,'""')}"`;return [heads.map(cell).join(","),...rows.map(r=>heads.map(h=>cell(r[h])).join(","))].join("\n");};
  const b64e=(v:string)=>{const bytes=new TextEncoder().encode(v);let b="";bytes.forEach(x=>b+=String.fromCharCode(x));return btoa(b);};
  const b64d=(v:string)=>new TextDecoder("utf-8",{fatal:true}).decode(Uint8Array.from(atob(v.replace(/\s+/g,"").replace(/-/g,"+").replace(/_/g,"/").padEnd(Math.ceil(v.length/4)*4,"=")),c=>c.charCodeAt(0)));
  const htmlEncode=(v:string)=>v.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
  const htmlDecode=(v:string)=>{const t=document.createElement("textarea");t.innerHTML=v;return t.value;};
  const parseXml=(v:string)=>{const d=new DOMParser().parseFromString(v,"application/xml"),e=d.querySelector("parsererror")??Array.from(d.getElementsByTagNameNS("*","parsererror"))[0];if(e)throw new Error(e.textContent?.replace(/\s+/g," ").trim()||"Invalid XML.");return d;};
  const formatXml=(v:string)=>{const s=new XMLSerializer().serializeToString(parseXml(v));const tokens=s.replace(/>\s*</g,"><").replace(/</g,"\n<").trim().split("\n");let l=0;return tokens.map(t=>{if(/^<\//.test(t))l=Math.max(0,l-1);const line=`${"  ".repeat(l)}${t}`;if(/^<[^!?/][^>]*[^/]?>$/.test(t)&&!/<\/[^>]+>$/.test(t))l++;return line;}).join("\n");};
  const positionToLineColumn=(source:string,pos:number)=>{const before=source.slice(0,pos),parts=before.split("\n");return {line:parts.length,column:(parts.at(-1)?.length??0)+1};};
  const extractJsonPosition=(message:string)=>{const m=message.match(/position\s+(\d+)/i);return m?Number(m[1]):null;};
  const extractLineColumn=(message:string)=>{const a=message.match(/line\s+(\d+)[^\d]+column\s+(\d+)/i),b=message.match(/at\s+line\s+(\d+)\s+column\s+(\d+)/i);const m=a??b;return m?{line:Number(m[1]),column:Number(m[2])}:null;};
  const preview=(source:string,line:number)=>source.split("\n").slice(Math.max(0,line-2),line+1).map((x,i)=>`${Math.max(1,line-1)+i}`.padStart(4," ")+` | ${x}`).join("\n");

  function setup(){document.querySelectorAll<HTMLElement>("[data-developer-tool]").forEach(root=>{if(root.dataset.initialized==="true")return;root.dataset.initialized="true";const mode=root.dataset.mode??"",isValidator=root.dataset.validator==="true";const input=root.querySelector<HTMLTextAreaElement>("[data-input]"),output=root.querySelector<HTMLTextAreaElement>("[data-output]"),count=root.querySelector<HTMLInputElement>("[data-count]"),card=root.querySelector<HTMLElement>("[data-validation-card]"),title=root.querySelector<HTMLElement>("[data-validation-title]"),location=root.querySelector<HTMLElement>("[data-validation-location]"),message=root.querySelector<HTMLElement>("[data-validation-message]"),errorPreview=root.querySelector<HTMLElement>("[data-error-preview]"),go=root.querySelector<HTMLButtonElement>("[data-go-error]"),status=root.querySelector<HTMLElement>("[data-status]");let errorOffset:number|null=null;let timer:ReturnType<typeof setTimeout>|undefined,debounce:ReturnType<typeof setTimeout>|undefined;
    const notify=(m:string,bad=false)=>{if(!status)return;status.textContent=m;status.classList.toggle("text-red-400",bad);status.classList.toggle("text-emerald-400",!bad);status.classList.replace("opacity-0","opacity-100");if(timer)clearTimeout(timer);timer=setTimeout(()=>status.classList.replace("opacity-100","opacity-0"),1200);};
    const valid=(label:string)=>{if(output)output.value=label;if(card){card.classList.remove("semantic-error");card.classList.add("semantic-success");}if(title)title.textContent=`✓ ${label}`;if(location)location.textContent="No syntax errors found";if(message)message.textContent="The document is syntactically valid.";errorPreview?.classList.add("hidden");go?.classList.add("hidden");errorOffset=null;};
    const invalid=(err:unknown)=>{const raw=err instanceof Error?err.message:String(err);let lc=extractLineColumn(raw);let offset:number|null=null;if(mode==="json-validator"){offset=extractJsonPosition(raw);if(offset!==null)lc=positionToLineColumn(input?.value??"",offset);}if(!lc)lc={line:1,column:1};if(offset===null){const lines=(input?.value??"").split("\n");offset=lines.slice(0,Math.max(0,lc.line-1)).reduce((n,x)=>n+x.length+1,0)+Math.max(0,lc.column-1);}errorOffset=offset;if(output)output.value=raw;if(card){card.classList.remove("semantic-success");card.classList.add("semantic-error");}if(title)title.textContent=`✕ Invalid ${mode.split("-")[0]?.toUpperCase()??"document"}`;if(location)location.textContent=`Line ${lc.line}, column ${lc.column}`;if(message)message.textContent=raw;if(errorPreview){errorPreview.textContent=preview(input?.value??"",lc.line);errorPreview.classList.remove("hidden");}go?.classList.remove("hidden");};
    const transform=()=>{const v=input?.value??"";if(!v){if(output)output.value="";if(isValidator){card?.classList.remove("semantic-success","semantic-error");if(title)title.textContent="Waiting for input";if(location)location.textContent="";if(message)message.textContent="Paste JSON, XML or YAML to validate.";errorPreview?.classList.add("hidden");go?.classList.add("hidden");}return;}try{let r="";switch(mode){case"json-formatter":r=JSON.stringify(JSON.parse(v),null,2);break;case"json-validator":JSON.parse(v);valid("Valid JSON");return;case"json-minifier":r=JSON.stringify(JSON.parse(v));break;case"json-escape":r=JSON.stringify(v).slice(1,-1);break;case"json-unescape":r=JSON.parse(v.startsWith('"')&&v.endsWith('"')?v:`"${v.replace(/\\/g,"\\\\").replace(/"/g,'\\"')}"`);break;case"json-to-csv":r=csv(JSON.parse(v));break;case"json-to-xml":r=`<?xml version="1.0" encoding="UTF-8"?>\n${toXml(JSON.parse(v))}`;break;case"json-to-yaml":r=toYaml(JSON.parse(v));break;case"base64-encode":r=b64e(v);break;case"base64-decode":r=b64d(v);break;case"url-encode":r=encodeURIComponent(v);break;case"url-decode":r=decodeURIComponent(v.replace(/\+/g," "));break;case"html-encode":r=htmlEncode(v);break;case"html-decode":r=htmlDecode(v);break;case"xml-formatter":r=formatXml(v);break;case"xml-validator":parseXml(v);valid("Valid XML");return;case"yaml-validator":{const docs=parseAllDocuments(v,{prettyErrors:true,strict:true,uniqueKeys:true});const errors=docs.flatMap(d=>d.errors);if(errors.length)throw errors[0];valid(docs.length>1?`Valid YAML stream (${docs.length} documents)`:"Valid YAML");return;}case"jwt-decoder":{const p=v.trim().split(".");if(p.length<2)throw new Error("A JWT must contain a header and payload.");const dec=(x:string)=>JSON.parse(b64d(x));r=`Header:\n${JSON.stringify(dec(p[0]??""),null,2)}\n\nPayload:\n${JSON.stringify(dec(p[1]??""),null,2)}\n\nWarning: signature not verified.`;break;}case"unix-timestamp-converter":{const t=v.trim(),d=/^-?\d+(\.\d+)?$/.test(t)?new Date(Math.abs(Number(t))<1e12?Number(t)*1000:Number(t)):new Date(t);if(Number.isNaN(d.getTime()))throw new Error("Invalid date or timestamp.");r=`ISO: ${d.toISOString()}\nUTC: ${d.toUTCString()}\nLocal: ${d.toLocaleString()}\nSeconds: ${Math.floor(d.getTime()/1000)}\nMilliseconds: ${d.getTime()}`;break;}}if(output)output.value=r;}catch(e){if(isValidator)invalid(e);else if(output)output.value=e instanceof Error?e.message:"Unable to process input.";}};
    input?.addEventListener("input",()=>{if(debounce)clearTimeout(debounce);debounce=setTimeout(transform,180);});
    root.querySelectorAll<HTMLButtonElement>("[data-generate]").forEach(btn=>btn.addEventListener("click",()=>{const n=Number.parseInt(count?.value??"1",10);if(!Number.isInteger(n)||n<1||n>100)return notify("Enter 1 to 100",true);if(output)output.value=Array.from({length:n},()=>crypto.randomUUID()).join("\n");notify("Generated");}));
    root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach(btn=>btn.addEventListener("click",async()=>{if(!output?.value)return notify("Nothing to copy",true);await navigator.clipboard.writeText(output.value);notify("Copied");}));
    root.querySelectorAll<HTMLButtonElement>("[data-clear]").forEach(btn=>btn.addEventListener("click",()=>{if(input)input.value="";if(output)output.value="";transform();notify("Cleared");}));
    go?.addEventListener("click",()=>{if(!input||errorOffset===null)return;input.focus();input.setSelectionRange(errorOffset,Math.min(input.value.length,errorOffset+1));});
  });}
  setup();document.addEventListener("astro:page-load",setup);
</script>
