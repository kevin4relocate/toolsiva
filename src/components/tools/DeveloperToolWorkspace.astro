---
interface Props {
  mode: string;
}

const { mode } = Astro.props;
const isValidator = mode.endsWith("-validator");
---

<section
  class="overflow-hidden rounded-3xl border border-white/10 bg-zinc-900/80 shadow-2xl shadow-black/20"
  data-developer-tool
  data-mode={mode}
  data-validator={isValidator ? "true" : "false"}
>
  <div class="p-4 sm:p-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-zinc-500">Processed locally in your browser.</p>

      <div class="flex flex-wrap items-center gap-2" data-actions>
        <span
          data-status
          class="pointer-events-none min-w-24 text-right text-sm font-medium text-emerald-400 opacity-0 transition-opacity duration-200"
          aria-live="polite"
        ></span>

        <button
          type="button"
          data-run
          class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition duration-150 hover:-translate-y-0.5 hover:bg-brand-500 active:translate-y-0 active:scale-[0.98]"
        >
          Process
        </button>

        <button
          type="button"
          data-copy
          class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium transition duration-150 hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-white/5 active:translate-y-0 active:scale-[0.98]"
        >
          Copy result
        </button>

        <button
          type="button"
          data-clear
          class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium transition duration-150 hover:-translate-y-0.5 hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200 active:translate-y-0 active:scale-[0.98]"
        >
          Clear
        </button>
      </div>
    </div>

    <label class="grid gap-2 text-sm text-zinc-300">
      Input
      <textarea
        data-input
        class="focus-ring min-h-72 w-full resize-y rounded-2xl border border-white/10 bg-zinc-950 p-5 font-mono text-sm leading-7 text-zinc-100 placeholder:text-zinc-600"
        placeholder="Paste your text, code or data here…"
        spellcheck="false"
      ></textarea>
    </label>

    <div class="mt-4">
      {
        isValidator ? (
          <div class="grid gap-2 text-sm text-zinc-300">
            Validation result
            <div
              data-validator-result
              class="min-h-16 rounded-2xl border border-white/10 bg-zinc-950/70 px-5 py-4 font-mono text-sm leading-6 text-zinc-400"
              aria-live="polite"
            >
              Enter data and select Process.
            </div>
            <textarea data-output class="hidden" readonly></textarea>
          </div>
        ) : (
          <label class="grid gap-2 text-sm text-zinc-300">
            Result
            <textarea
              data-output
              readonly
              class="focus-ring min-h-64 w-full resize-y rounded-2xl border border-white/10 bg-zinc-950/70 p-5 font-mono text-sm leading-7 text-zinc-100"
            ></textarea>
          </label>
        )
      }
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-end gap-2" data-actions>
      <span
        data-status
        class="pointer-events-none min-w-24 text-right text-sm font-medium text-emerald-400 opacity-0 transition-opacity duration-200"
        aria-live="polite"
      ></span>

      <button
        type="button"
        data-run
        class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition duration-150 hover:-translate-y-0.5 hover:bg-brand-500 active:translate-y-0 active:scale-[0.98]"
      >
        Process
      </button>

      <button
        type="button"
        data-copy
        class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium transition duration-150 hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-white/5 active:translate-y-0 active:scale-[0.98]"
      >
        Copy result
      </button>

      <button
        type="button"
        data-clear
        class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium transition duration-150 hover:-translate-y-0.5 hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200 active:translate-y-0 active:scale-[0.98]"
      >
        Clear
      </button>
    </div>
  </div>
</section>

<script>
  import { parseAllDocuments } from "yaml";

  const escapeXml = (value: string) =>
    value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&apos;");

  const safeXmlName = (value: string) => {
    const cleaned = value.replace(/[^A-Za-z0-9_.-]/g, "_");
    return /^[A-Za-z_]/.test(cleaned) ? cleaned : `item_${cleaned}`;
  };

  const toXml = (value: unknown, name = "root", level = 0): string => {
    const indent = "  ".repeat(level);
    const tag = safeXmlName(name);

    if (Array.isArray(value)) {
      const children = value.map((item) => toXml(item, "item", level + 1)).join("\n");
      return `${indent}<${tag}>${children ? `\n${children}\n${indent}` : ""}</${tag}>`;
    }

    if (value !== null && typeof value === "object") {
      const children = Object.entries(value as Record<string, unknown>)
        .map(([key, item]) => toXml(item, key, level + 1))
        .join("\n");
      return `${indent}<${tag}>${children ? `\n${children}\n${indent}` : ""}</${tag}>`;
    }

    if (value === null) return `${indent}<${tag} />`;
    return `${indent}<${tag}>${escapeXml(String(value))}</${tag}>`;
  };

  const yamlScalar = (value: unknown) => {
    if (value === null) return "null";
    if (typeof value === "boolean" || typeof value === "number") return String(value);

    const text = String(value);
    return text === "" ||
      /[:#\n\r\t]|^\s|\s$|^(true|false|null|yes|no|[-+]?\d+(\.\d+)?)$/i.test(text)
      ? JSON.stringify(text)
      : text;
  };

  const toYaml = (value: unknown, level = 0): string => {
    const indent = "  ".repeat(level);

    if (Array.isArray(value)) {
      if (value.length === 0) return `${indent}[]`;

      return value
        .map((item) => {
          if (item !== null && typeof item === "object") {
            const nested = toYaml(item, level + 1).split("\n");
            return `${indent}- ${nested[0]?.trimStart() ?? ""}${
              nested.length > 1 ? `\n${nested.slice(1).join("\n")}` : ""
            }`;
          }

          return `${indent}- ${yamlScalar(item)}`;
        })
        .join("\n");
    }

    if (value !== null && typeof value === "object") {
      const entries = Object.entries(value as Record<string, unknown>);
      if (entries.length === 0) return `${indent}{}`;

      return entries
        .map(([key, item]) => {
          const safeKey = /^[A-Za-z0-9_-]+$/.test(key) ? key : JSON.stringify(key);

          return item !== null && typeof item === "object"
            ? `${indent}${safeKey}:\n${toYaml(item, level + 1)}`
            : `${indent}${safeKey}: ${yamlScalar(item)}`;
        })
        .join("\n");
    }

    return `${indent}${yamlScalar(value)}`;
  };

  const jsonToCsv = (value: unknown): string => {
    if (!Array.isArray(value)) throw new Error("Expected a JSON array of objects.");

    if (
      value.some(
        (item) => item === null || Array.isArray(item) || typeof item !== "object",
      )
    ) {
      throw new Error("Every array item must be a JSON object.");
    }

    const rows = value as Record<string, unknown>[];
    const headers = Array.from(new Set(rows.flatMap((row) => Object.keys(row))));
    if (headers.length === 0) return "";

    const cell = (item: unknown) => {
      const raw =
        item !== null && typeof item === "object"
          ? JSON.stringify(item)
          : String(item ?? "");

      return `"${raw.replace(/"/g, '""')}"`;
    };

    return [
      headers.map(cell).join(","),
      ...rows.map((row) => headers.map((header) => cell(row[header])).join(",")),
    ].join("\n");
  };

  const encodeBase64 = (value: string) => {
    const bytes = new TextEncoder().encode(value);
    let binary = "";

    bytes.forEach((byte) => {
      binary += String.fromCharCode(byte);
    });

    return btoa(binary);
  };

  const decodeBase64 = (value: string) => {
    const binary = atob(value.replace(/\s+/g, ""));

    return new TextDecoder("utf-8", { fatal: true }).decode(
      Uint8Array.from(binary, (character) => character.charCodeAt(0)),
    );
  };

  const decodeBase64Url = (value: string) => {
    const normalized = value.replace(/-/g, "+").replace(/_/g, "/");
    const padded = normalized.padEnd(Math.ceil(normalized.length / 4) * 4, "=");
    return decodeBase64(padded);
  };

  const htmlEncode = (value: string) =>
    value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");

  const htmlDecode = (value: string) => {
    const textarea = document.createElement("textarea");
    textarea.innerHTML = value;
    return textarea.value;
  };

  const formatXml = (value: string) => {
    const parsed = new DOMParser().parseFromString(value, "application/xml");
    const parserError =
      parsed.querySelector("parsererror") ??
      Array.from(parsed.getElementsByTagNameNS("*", "parsererror"))[0];

    if (parserError) {
      throw new Error(
        parserError.textContent?.replace(/\s+/g, " ").trim() || "Invalid XML.",
      );
    }

    const serialized = new XMLSerializer().serializeToString(parsed);
    const tokens = serialized
      .replace(/>\s*</g, "><")
      .replace(/</g, "\n<")
      .trim()
      .split("\n");

    let level = 0;

    return tokens
      .map((token) => {
        if (/^<\//.test(token)) level = Math.max(0, level - 1);

        const line = `${"  ".repeat(level)}${token}`;

        if (
          /^<[^!?/][^>]*[^/]?>$/.test(token) &&
          !/<\/[^>]+>$/.test(token)
        ) {
          level += 1;
        }

        return line;
      })
      .join("\n");
  };

  const convertUnixTimestamp = (value: string) => {
    const trimmed = value.trim();
    if (!trimmed) throw new Error("Enter a Unix timestamp or date.");

    if (/^-?\d+(\.\d+)?$/.test(trimmed)) {
      const numeric = Number(trimmed);
      if (!Number.isFinite(numeric)) throw new Error("Invalid timestamp.");

      const milliseconds = Math.abs(numeric) < 1e12 ? numeric * 1000 : numeric;
      const date = new Date(milliseconds);
      if (Number.isNaN(date.getTime())) throw new Error("Invalid timestamp.");

      return [
        `ISO: ${date.toISOString()}`,
        `UTC: ${date.toUTCString()}`,
        `Local: ${date.toLocaleString()}`,
        `Seconds: ${Math.floor(date.getTime() / 1000)}`,
        `Milliseconds: ${date.getTime()}`,
      ].join("\n");
    }

    const date = new Date(trimmed);
    if (Number.isNaN(date.getTime())) throw new Error("Invalid date.");

    return [
      `ISO: ${date.toISOString()}`,
      `Seconds: ${Math.floor(date.getTime() / 1000)}`,
      `Milliseconds: ${date.getTime()}`,
    ].join("\n");
  };

  const validateJson = (value: string) => {
    if (!value.trim()) throw new Error("Enter JSON to validate.");
    JSON.parse(value);
    return "Valid JSON";
  };

  const validateXml = (value: string) => {
    if (!value.trim()) throw new Error("Enter XML to validate.");

    const parsed = new DOMParser().parseFromString(value, "application/xml");
    const parserError =
      parsed.querySelector("parsererror") ??
      Array.from(parsed.getElementsByTagNameNS("*", "parsererror"))[0];

    if (parserError) {
      const message = parserError.textContent?.replace(/\s+/g, " ").trim();
      throw new Error(message || "Invalid XML.");
    }

    return "Valid well-formed XML";
  };

  const validateYaml = (value: string) => {
    if (!value.trim()) throw new Error("Enter YAML to validate.");

    const documents = parseAllDocuments(value, {
      prettyErrors: true,
      strict: true,
      uniqueKeys: true,
    });

    const errors = documents.flatMap((document) => document.errors);

    if (errors.length > 0) {
      throw new Error(errors.map((error) => error.message).join("\n"));
    }

    const warnings = documents.flatMap((document) => document.warnings);

    if (warnings.length > 0) {
      return `Valid YAML with ${warnings.length} warning${
        warnings.length === 1 ? "" : "s"
      }:\n${warnings.map((warning) => warning.message).join("\n")}`;
    }

    return documents.length > 1
      ? `Valid YAML stream (${documents.length} documents)`
      : "Valid YAML";
  };

  function setupDeveloperTools() {
    document.querySelectorAll<HTMLElement>("[data-developer-tool]").forEach((root) => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const mode = root.dataset.mode ?? "";
      const isValidator = root.dataset.validator === "true";
      const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
      const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
      const validatorResult =
        root.querySelector<HTMLElement>("[data-validator-result]");
      const runButtons =
        root.querySelectorAll<HTMLButtonElement>("[data-run]");
      const copyButtons =
        root.querySelectorAll<HTMLButtonElement>("[data-copy]");
      const clearButtons =
        root.querySelectorAll<HTMLButtonElement>("[data-clear]");
      const statuses =
        root.querySelectorAll<HTMLElement>("[data-status]");

      let timer = 0;

      if (mode === "uuid-generator" && input) {
        input.placeholder =
          "Click Process to generate UUIDs. Enter a number from 1 to 100 to generate multiple values.";
      } else if (mode === "jwt-decoder" && input) {
        input.placeholder = "Paste a JWT token here…";
      } else if (mode === "unix-timestamp-converter" && input) {
        input.placeholder =
          "Enter a Unix timestamp or date, for example 1767225600 or 2026-01-01…";
      }

      const updateValidatorResult = (
        message: string,
        state: "idle" | "valid" | "invalid",
      ) => {
        if (!validatorResult) return;

        validatorResult.textContent = message;
        validatorResult.classList.toggle(
          "border-emerald-400/30",
          state === "valid",
        );
        validatorResult.classList.toggle(
          "bg-emerald-500/10",
          state === "valid",
        );
        validatorResult.classList.toggle(
          "text-emerald-300",
          state === "valid",
        );
        validatorResult.classList.toggle(
          "border-red-400/30",
          state === "invalid",
        );
        validatorResult.classList.toggle(
          "bg-red-500/10",
          state === "invalid",
        );
        validatorResult.classList.toggle(
          "text-red-300",
          state === "invalid",
        );
        validatorResult.classList.toggle(
          "text-zinc-400",
          state === "idle",
        );
      };

      const showStatus = (message: string, error = false) => {
        window.clearTimeout(timer);

        statuses.forEach((status) => {
          status.textContent = message;
          status.classList.toggle("text-red-400", error);
          status.classList.toggle("text-emerald-400", !error);
          status.classList.remove("opacity-0");
          status.classList.add("opacity-100");
        });

        timer = window.setTimeout(() => {
          statuses.forEach((status) => {
            status.classList.remove("opacity-100");
            status.classList.add("opacity-0");
          });
        }, 1800);
      };

      const flashButtons = (
        buttons: NodeListOf<HTMLButtonElement>,
        label: string,
      ) => {
        buttons.forEach((button) => {
          const original = button.textContent ?? "";
          button.textContent = label;
          button.classList.add("ring-2", "ring-emerald-400/60");

          window.setTimeout(() => {
            button.textContent = original;
            button.classList.remove("ring-2", "ring-emerald-400/60");
          }, 900);
        });
      };

      const process = () => {
        if (!input || !output) return;

        try {
          const value = input.value;
          let result = "";

          switch (mode) {
            case "json-formatter":
              result = JSON.stringify(JSON.parse(value), null, 2);
              break;
            case "json-validator":
              result = validateJson(value);
              break;
            case "json-minifier":
              result = JSON.stringify(JSON.parse(value));
              break;
            case "json-escape":
              result = JSON.stringify(value).slice(1, -1);
              break;
            case "json-unescape":
              result = JSON.parse(
                value.startsWith('"') && value.endsWith('"')
                  ? value
                  : `"${value.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`,
              );
              break;
            case "json-to-csv":
              result = jsonToCsv(JSON.parse(value));
              break;
            case "json-to-xml":
              result = `<?xml version="1.0" encoding="UTF-8"?>\n${toXml(
                JSON.parse(value),
              )}`;
              break;
            case "json-to-yaml":
              result = toYaml(JSON.parse(value));
              break;
            case "base64-encode":
              result = encodeBase64(value);
              break;
            case "base64-decode":
              result = decodeBase64(value);
              break;
            case "url-encode":
              result = encodeURIComponent(value);
              break;
            case "url-decode":
              result = decodeURIComponent(value.replace(/\+/g, " "));
              break;
            case "html-encode":
              result = htmlEncode(value);
              break;
            case "html-decode":
              result = htmlDecode(value);
              break;
            case "xml-formatter":
              result = formatXml(value);
              break;
            case "xml-validator":
              result = validateXml(value);
              break;
            case "yaml-validator":
              result = validateYaml(value);
              break;
            case "uuid-generator": {
              const count = value.trim()
                ? Number.parseInt(value.trim(), 10)
                : 1;

              if (!Number.isInteger(count) || count < 1 || count > 100) {
                throw new Error("Enter a number from 1 to 100.");
              }

              result = Array.from(
                { length: count },
                () => crypto.randomUUID(),
              ).join("\n");
              break;
            }
            case "jwt-decoder": {
              const parts = value.trim().split(".");

              if (parts.length < 2) {
                throw new Error(
                  "A JWT must contain at least a header and payload.",
                );
              }

              const header = JSON.parse(decodeBase64Url(parts[0] ?? ""));
              const payload = JSON.parse(decodeBase64Url(parts[1] ?? ""));

              result = `Header:\n${JSON.stringify(
                header,
                null,
                2,
              )}\n\nPayload:\n${JSON.stringify(
                payload,
                null,
                2,
              )}\n\nWarning: signature not verified.`;
              break;
            }
            case "unix-timestamp-converter":
              result = convertUnixTimestamp(value);
              break;
          }

          output.value = result;

          if (isValidator) {
            updateValidatorResult(result, "valid");
          }

          flashButtons(
            runButtons,
            isValidator ? "Valid!" : "Processed",
          );
          showStatus(isValidator ? "Syntax accepted" : "Result updated");
        } catch (error) {
          const message =
            error instanceof Error
              ? error.message
              : "Unable to process input.";

          output.value = "";

          if (isValidator) {
            updateValidatorResult(message, "invalid");
          }

          showStatus(message, true);
        }
      };

      runButtons.forEach((button) => {
        button.addEventListener("click", process);
      });

      copyButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          if (!output?.value) {
            showStatus("Nothing to copy", true);
            return;
          }

          await navigator.clipboard.writeText(output.value);
          flashButtons(copyButtons, "Copied!");
          showStatus("Copied to clipboard");
        });
      });

      clearButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (input) input.value = "";
          if (output) output.value = "";

          if (isValidator) {
            updateValidatorResult(
              "Enter data and select Process.",
              "idle",
            );
          }

          flashButtons(clearButtons, "Cleared");
          showStatus("All fields cleared");
          input?.focus();
        });
      });
    });
  }

  setupDeveloperTools();
  document.addEventListener("astro:page-load", setupDeveloperTools);
</script>
