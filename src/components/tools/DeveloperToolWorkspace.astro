---
interface Props { mode: string; }
const { mode } = Astro.props;
const validators = new Set(["json-validator","xml-validator","yaml-validator"]);
const isValidator = validators.has(mode);
const isUuid = mode === "uuid-generator";
const isJwt = mode === "jwt-decoder";
const isTimestamp = mode === "unix-timestamp-converter";
const isDual = !isValidator && !isUuid && !isJwt && !isTimestamp;
---
<section class="overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/80 shadow-xl shadow-black/20" data-developer-tool data-mode={mode} data-validator={isValidator ? "true" : "false"}>
  <div class="p-3 sm:p-4">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2.5"><p class="text-xs text-zinc-500">{isUuid ? "Generated locally in your browser." : "Updates automatically in your browser."}</p><div class="flex items-center gap-2"><span data-status class="min-w-20 text-right text-xs font-medium text-emerald-400 opacity-0 transition-opacity"></span>{isUuid && <button data-generate type="button" class="rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white">Generate UUIDs</button>}<button data-copy type="button" class="rounded-lg border border-white/10 px-3 py-2 text-sm">Copy result</button><button data-clear type="button" class="rounded-lg border border-white/10 px-3 py-2 text-sm">Clear</button></div></div>
    {isDual && <div class="grid gap-3 lg:grid-cols-2"><label class="grid gap-1.5 text-sm text-zinc-300">Input<textarea data-input class="min-h-[clamp(13rem,34vh,22rem)] resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 font-mono text-sm leading-6" placeholder="Paste input…"></textarea></label><label class="grid gap-1.5 text-sm text-zinc-300">Result<textarea data-output readonly class="min-h-[clamp(13rem,34vh,22rem)] resize-y rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6"></textarea></label></div>}
    {isValidator && <><label class="grid gap-1.5 text-sm text-zinc-300">Editor<textarea data-input class="min-h-[clamp(14rem,38vh,24rem)] resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 font-mono text-sm leading-6" placeholder="Paste data to validate…"></textarea></label><div data-validation-card class="mt-3 rounded-xl border border-white/10 bg-zinc-950/60 p-4"><div class="flex items-center justify-between gap-3"><div><strong data-validation-title class="block text-sm text-zinc-200">Waiting for input</strong><span data-validation-location class="mt-1 block text-xs text-zinc-500"></span></div><button data-go-error type="button" class="hidden rounded-lg border border-red-400/30 px-3 py-2 text-xs text-red-200">Go to error</button></div><p data-validation-message class="mt-2 whitespace-pre-wrap font-mono text-sm leading-6 text-zinc-400">Paste JSON, XML or YAML to validate.</p><pre data-error-preview class="mt-3 hidden overflow-auto rounded-lg border border-red-400/20 bg-black/25 p-3 text-xs leading-5"></pre></div><textarea data-output class="hidden" readonly></textarea></>}
    {isUuid && <div class="grid gap-3 lg:grid-cols-[16rem_1fr]"><label class="grid content-start gap-1.5 text-sm text-zinc-300">Number of UUIDs<input data-count type="number" min="1" max="100" value="1" class="rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5" /></label><label class="grid gap-1.5 text-sm text-zinc-300">Generated UUIDs<textarea data-output readonly class="min-h-[11rem] resize-y rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6"></textarea></label></div>}
    {isJwt && <div class="grid gap-3"><label class="grid gap-1.5 text-sm text-zinc-300">JWT token<textarea data-input class="min-h-28 resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 font-mono text-sm leading-6" placeholder="Paste a JWT…"></textarea></label><div class="grid gap-3 lg:grid-cols-2"><div><span class="mb-1.5 block text-sm text-zinc-300">Header</span><pre data-jwt-header class="min-h-36 overflow-auto rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6 text-zinc-400">Waiting for token.</pre></div><div><span class="mb-1.5 block text-sm text-zinc-300">Payload</span><pre data-jwt-payload class="min-h-36 overflow-auto rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6 text-zinc-400">Waiting for token.</pre></div></div><p class="text-xs text-amber-300">The signature is decoded but not verified.</p><textarea data-output class="hidden" readonly></textarea></div>}
    {isTimestamp && <div class="grid gap-3 lg:grid-cols-[minmax(16rem,0.7fr)_minmax(0,1.3fr)]"><label class="grid content-start gap-1.5 text-sm text-zinc-300">Timestamp or date<input data-input class="rounded-xl border border-white/10 bg-zinc-950 px-4 py-3" placeholder="1704067200 or 2024-01-01" /></label><div><span class="mb-1.5 block text-sm text-zinc-300">Converted values</span><pre data-result-card class="min-h-36 whitespace-pre-wrap rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6 text-zinc-400">Enter a timestamp or date.</pre><textarea data-output class="hidden" readonly></textarea></div></div>}
  </div>
</section>
<script>
  import { parseAllDocuments } from "yaml";
  const enc=new TextEncoder();const b64e=(v:string)=>{let raw="";enc.encode(v).forEach(b=>raw+=String.fromCharCode(b));return btoa(raw);};const b64d=(v:string)=>new TextDecoder("utf-8",{fatal:true}).decode(Uint8Array.from(atob(v.replace(/\s+/g,"").replace(/-/g,"+").replace(/_/g,"/").padEnd(Math.ceil(v.length/4)*4,"=")),c=>c.charCodeAt(0)));
  const htmlE=(v:string)=>v.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");const htmlD=(v:string)=>{const t=document.createElement("textarea");t.innerHTML=v;return t.value;};const parseXml=(v:string)=>{const d=new DOMParser().parseFromString(v,"application/xml"),e=d.querySelector("parsererror")??Array.from(d.getElementsByTagNameNS("*","parsererror"))[0];if(e)throw new Error(e.textContent?.replace(/\s+/g," ").trim()||"Invalid XML.");return d;};const formatXml=(v:string)=>{const s=new XMLSerializer().serializeToString(parseXml(v));const tokens=s.replace(/>\s*</g,"><").replace(/</g,"\n<").trim().split("\n");let level=0;return tokens.map(t=>{if(/^<\//.test(t))level=Math.max(0,level-1);const line=`${"  ".repeat(level)}${t}`;if(/^<[^!?/][^>]*[^/]?>$/.test(t)&&!/<\/[^>]+>$/.test(t))level++;return line;}).join("\n");};const xmlE=(v:string)=>v.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&apos;");const safe=(v:string)=>{const x=v.replace(/[^A-Za-z0-9_.-]/g,"_");return /^[A-Za-z_]/.test(x)?x:`item_${x}`;};const toXml=(v:unknown,n="root",l=0):string=>{const i="  ".repeat(l),t=safe(n);if(Array.isArray(v)){const c=v.map(x=>toXml(x,"item",l+1)).join("\n");return `${i}<${t}>${c?`\n${c}\n${i}`:""}</${t}>`;}if(v!==null&&typeof v==="object"){const c=Object.entries(v as Record<string,unknown>).map(([k,x])=>toXml(x,k,l+1)).join("\n");return `${i}<${t}>${c?`\n${c}\n${i}`:""}</${t}>`;}return v===null?`${i}<${t} />`:`${i}<${t}>${xmlE(String(v))}</${t}>`;};const scalar=(v:unknown)=>v===null?"null":typeof v==="boolean"||typeof v==="number"?String(v):JSON.stringify(String(v));const toYaml=(v:unknown,l=0):string=>{const i="  ".repeat(l);if(Array.isArray(v))return v.length?v.map(x=>x!==null&&typeof x==="object"?`${i}-\n${toYaml(x,l+1)}`:`${i}- ${scalar(x)}`).join("\n"):`${i}[]`;if(v!==null&&typeof v==="object")return Object.entries(v as Record<string,unknown>).map(([k,x])=>x!==null&&typeof x==="object"?`${i}${k}:\n${toYaml(x,l+1)}`:`${i}${k}: ${scalar(x)}`).join("\n")||`${i}{}`;return `${i}${scalar(v)}`;};const csv=(v:unknown)=>{if(!Array.isArray(v)||v.some(x=>x===null||Array.isArray(x)||typeof x!=="object"))throw new Error("Expected a JSON array of objects.");const rows=v as Record<string,unknown>[],heads=[...new Set(rows.flatMap(r=>Object.keys(r)))],cell=(x:unknown)=>`"${(x!==null&&typeof x==="object"?JSON.stringify(x):String(x??"")).replace(/"/g,'""')}"`;return [heads.map(cell).join(","),...rows.map(r=>heads.map(h=>cell(r[h])).join(","))].join("\n");};
  const pos=(src:string,p:number)=>{const a=src.slice(0,p).split("\n");return {line:a.length,column:(a.at(-1)?.length??0)+1};};const lineCol=(m:string)=>{const x=m.match(/line\s+(\d+)[^\d]+column\s+(\d+)/i);return x?{line:Number(x[1]),column:Number(x[2])}:null;};
  function setup(){document.querySelectorAll<HTMLElement>("[data-developer-tool]").forEach(root=>{if(root.dataset.initialized==="true")return;root.dataset.initialized="true";const mode=root.dataset.mode??"",validator=root.dataset.validator==="true";const input=root.querySelector<HTMLInputElement|HTMLTextAreaElement>("[data-input]"),output=root.querySelector<HTMLTextAreaElement>("[data-output]"),status=root.querySelector<HTMLElement>("[data-status]"),card=root.querySelector<HTMLElement>("[data-validation-card]"),title=root.querySelector<HTMLElement>("[data-validation-title]"),location=root.querySelector<HTMLElement>("[data-validation-location]"),message=root.querySelector<HTMLElement>("[data-validation-message]"),preview=root.querySelector<HTMLElement>("[data-error-preview]"),go=root.querySelector<HTMLButtonElement>("[data-go-error]");let timer:ReturnType<typeof setTimeout>|undefined,debounce:ReturnType<typeof setTimeout>|undefined,errorOffset:number|null=null;
    const notify=(m:string,bad=false)=>{if(!status)return;status.textContent=m;status.classList.toggle("text-red-400",bad);status.classList.toggle("text-emerald-400",!bad);status.classList.replace("opacity-0","opacity-100");if(timer)clearTimeout(timer);timer=setTimeout(()=>status.classList.replace("opacity-100","opacity-0"),1200);};const valid=(label:string)=>{if(output)output.value=label;card?.classList.remove("semantic-error");card?.classList.add("semantic-success");if(title)title.textContent=`✓ ${label}`;if(location)location.textContent="No syntax errors found";if(message)message.textContent="The document is syntactically valid.";preview?.classList.add("hidden");go?.classList.add("hidden");};const invalid=(err:unknown)=>{const raw=err instanceof Error?err.message:String(err);let lc=lineCol(raw),offset=raw.match(/position\s+(\d+)/i);if(offset&&input)lc=pos(input.value,Number(offset[1]));lc??={line:1,column:1};errorOffset=(input?.value??"").split("\n").slice(0,lc.line-1).reduce((n,x)=>n+x.length+1,0)+lc.column-1;if(output)output.value=raw;card?.classList.remove("semantic-success");card?.classList.add("semantic-error");if(title)title.textContent="✕ Invalid document";if(location)location.textContent=`Line ${lc.line}, column ${lc.column}`;if(message)message.textContent=raw;if(preview){preview.textContent=(input?.value??"").split("\n").slice(Math.max(0,lc.line-2),lc.line+1).map((x,i)=>`${Math.max(1,lc.line-1)+i}`.padStart(4," ")+` | ${x}`).join("\n");preview.classList.remove("hidden");}go?.classList.remove("hidden");};
    const transform=()=>{const v=input?.value??"";if(!v){if(output)output.value="";return;}try{let r="";switch(mode){case"json-formatter":r=JSON.stringify(JSON.parse(v),null,2);break;case"json-validator":JSON.parse(v);valid("Valid JSON");return;case"json-minifier":r=JSON.stringify(JSON.parse(v));break;case"json-escape":r=JSON.stringify(v).slice(1,-1);break;case"json-unescape":r=JSON.parse(v.startsWith('"')&&v.endsWith('"')?v:`"${v.replace(/\\/g,"\\\\").replace(/"/g,'\\"')}"`);break;case"json-to-csv":r=csv(JSON.parse(v));break;case"json-to-xml":r=`<?xml version="1.0" encoding="UTF-8"?>\n${toXml(JSON.parse(v))}`;break;case"json-to-yaml":r=toYaml(JSON.parse(v));break;case"base64-encode":r=b64e(v);break;case"base64-decode":r=b64d(v);break;case"url-encode":r=encodeURIComponent(v);break;case"url-decode":r=decodeURIComponent(v.replace(/\+/g," "));break;case"html-encode":r=htmlE(v);break;case"html-decode":r=htmlD(v);break;case"xml-formatter":r=formatXml(v);break;case"xml-validator":parseXml(v);valid("Valid XML");return;case"yaml-validator":{const docs=parseAllDocuments(v,{prettyErrors:true,strict:true,uniqueKeys:true});const errors=docs.flatMap(d=>d.errors);if(errors.length)throw errors[0];valid("Valid YAML");return;}case"jwt-decoder":{const parts=v.trim().split(".");if(parts.length<2)throw new Error("A JWT must contain a header and payload.");const h=JSON.stringify(JSON.parse(b64d(parts[0]??"")),null,2),p=JSON.stringify(JSON.parse(b64d(parts[1]??"")),null,2);const he=root.querySelector<HTMLElement>("[data-jwt-header]"),pe=root.querySelector<HTMLElement>("[data-jwt-payload]");if(he)he.textContent=h;if(pe)pe.textContent=p;r=`Header:\n${h}\n\nPayload:\n${p}`;break;}case"unix-timestamp-converter":{const t=v.trim(),d=/^-?\d+(\.\d+)?$/.test(t)?new Date(Math.abs(Number(t))<1e12?Number(t)*1000:Number(t)):new Date(t);if(Number.isNaN(d.getTime()))throw new Error("Invalid date or timestamp.");r=`ISO: ${d.toISOString()}\nUTC: ${d.toUTCString()}\nLocal: ${d.toLocaleString()}\nSeconds: ${Math.floor(d.getTime()/1000)}\nMilliseconds: ${d.getTime()}`;const result=root.querySelector<HTMLElement>("[data-result-card]");if(result)result.textContent=r;break;}}if(output)output.value=r;}catch(e){if(validator)invalid(e);else if(output)output.value=e instanceof Error?e.message:"Unable to process input.";}};
    input?.addEventListener("input",()=>{if(debounce)clearTimeout(debounce);debounce=setTimeout(transform,160);});root.querySelectorAll<HTMLButtonElement>("[data-generate]").forEach(b=>b.addEventListener("click",()=>{const n=Number(root.querySelector<HTMLInputElement>("[data-count]")?.value??1);if(!Number.isInteger(n)||n<1||n>100)return notify("Enter 1 to 100",true);if(output)output.value=Array.from({length:n},()=>crypto.randomUUID()).join("\n");notify("Generated");}));root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach(b=>b.addEventListener("click",async()=>{if(!output?.value)return notify("Nothing to copy",true);await navigator.clipboard.writeText(output.value);notify("Copied");}));root.querySelectorAll<HTMLButtonElement>("[data-clear]").forEach(b=>b.addEventListener("click",()=>{if(input)input.value="";if(output)output.value="";transform();notify("Cleared");}));go?.addEventListener("click",()=>{if(!input||errorOffset===null)return;input.focus();input.setSelectionRange(errorOffset,Math.min(input.value.length,errorOffset+1));});
  });}setup();document.addEventListener("astro:page-load",setup);
</script>
