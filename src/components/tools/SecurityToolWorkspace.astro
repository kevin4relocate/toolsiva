---
interface Props {
  mode: string;
}

const { mode } = Astro.props;

const compactModes = new Set([
  "password-strength-checker",
  "hash-compare",
]);
const isCompact = compactModes.has(mode);
---

<section
  class="overflow-hidden rounded-3xl border border-white/10 bg-zinc-900/80 shadow-2xl shadow-black/20"
  data-security-tool
  data-mode={mode}
  data-compact={isCompact ? "true" : "false"}
>
  <div class="p-4 sm:p-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-zinc-500">Generated and processed locally in your browser.</p>
      <div class="flex flex-wrap items-center gap-2" data-actions>
        <span data-status class="pointer-events-none min-w-24 text-right text-sm font-medium text-emerald-400 opacity-0 transition-opacity duration-200" aria-live="polite"></span>
        <button type="button" data-run class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500 active:translate-y-0 active:scale-[0.98]">Process</button>
        <button type="button" data-copy class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium transition hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-white/5 active:translate-y-0 active:scale-[0.98]">Copy result</button>
        <button type="button" data-clear class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium transition hover:-translate-y-0.5 hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200 active:translate-y-0 active:scale-[0.98]">Clear</button>
      </div>
    </div>

    <div class="grid gap-4" data-fields>
      <label class="grid gap-2 text-sm text-zinc-300" data-field="primary">
        <span data-primary-label>Input</span>
        <textarea data-input class="focus-ring min-h-44 w-full resize-y rounded-2xl border border-white/10 bg-zinc-950 p-5 font-mono text-sm leading-7 text-zinc-100 placeholder:text-zinc-600" placeholder="Enter input…" spellcheck="false"></textarea>
      </label>

      <label class="hidden gap-2 text-sm text-zinc-300" data-field="secondary">
        <span data-secondary-label>Second value</span>
        <textarea data-secondary class="focus-ring min-h-28 w-full resize-y rounded-2xl border border-white/10 bg-zinc-950 p-5 font-mono text-sm leading-7 text-zinc-100 placeholder:text-zinc-600" placeholder="Enter second value…" spellcheck="false"></textarea>
      </label>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-options>
        <label class="grid gap-2 text-sm text-zinc-300" data-option="length">
          Length
          <input data-length type="number" min="1" max="4096" value="24" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-zinc-100" />
        </label>

        <label class="hidden gap-2 text-sm text-zinc-300" data-option="count">
          Word count
          <input data-count type="number" min="3" max="12" value="5" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-zinc-100" />
        </label>

        <label class="hidden gap-2 text-sm text-zinc-300" data-option="separator">
          Separator
          <input data-separator type="text" maxlength="8" value="-" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-zinc-100" />
        </label>

        <label class="hidden gap-2 text-sm text-zinc-300" data-option="algorithm">
          Algorithm
          <select data-algorithm class="focus-ring cursor-pointer rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-zinc-100">
            <option value="SHA-256">SHA-256</option>
            <option value="SHA-512">SHA-512</option>
          </select>
        </label>

        <label class="hidden gap-2 text-sm text-zinc-300" data-option="format">
          Format
          <select data-format class="focus-ring cursor-pointer rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-zinc-100">
            <option value="hex">Hexadecimal</option>
            <option value="base64url">Base64 URL-safe</option>
          </select>
        </label>
      </div>

      <div class="flex flex-wrap gap-x-5 gap-y-3 text-sm text-zinc-300" data-character-options>
        <label class="flex cursor-pointer items-center gap-2"><input data-lowercase type="checkbox" checked /> Lowercase</label>
        <label class="flex cursor-pointer items-center gap-2"><input data-uppercase type="checkbox" checked /> Uppercase</label>
        <label class="flex cursor-pointer items-center gap-2"><input data-numbers type="checkbox" checked /> Numbers</label>
        <label class="flex cursor-pointer items-center gap-2"><input data-symbols type="checkbox" checked /> Symbols</label>
      </div>

      <label class="hidden cursor-pointer items-center gap-2 text-sm text-zinc-300" data-case-option>
        <input data-ignore-case type="checkbox" checked />
        Ignore letter case
      </label>
    </div>

    <div class="mt-4">
      {
        isCompact ? (
          <div class="grid gap-2 text-sm text-zinc-300">
            Result
            <div data-compact-result class="min-h-20 whitespace-pre-wrap rounded-2xl border border-white/10 bg-zinc-950/70 px-5 py-4 font-mono text-sm leading-6 text-zinc-400" aria-live="polite">
              Enter data and select Process.
            </div>
            <textarea data-output class="hidden" readonly></textarea>
          </div>
        ) : (
          <label class="grid gap-2 text-sm text-zinc-300">
            Result
            <textarea data-output readonly class="focus-ring min-h-48 w-full resize-y rounded-2xl border border-white/10 bg-zinc-950/70 p-5 font-mono text-sm leading-7 text-zinc-100"></textarea>
          </label>
        )
      }
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-end gap-2" data-actions>
      <span data-status class="pointer-events-none min-w-24 text-right text-sm font-medium text-emerald-400 opacity-0 transition-opacity duration-200" aria-live="polite"></span>
      <button type="button" data-run class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500 active:translate-y-0 active:scale-[0.98]">Process</button>
      <button type="button" data-copy class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium transition hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-white/5 active:translate-y-0 active:scale-[0.98]">Copy result</button>
      <button type="button" data-clear class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium transition hover:-translate-y-0.5 hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200 active:translate-y-0 active:scale-[0.98]">Clear</button>
    </div>
  </div>
</section>

<script>
  const encoder = new TextEncoder();

  const bytesToHex = (bytes: Uint8Array) =>
    Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");

  const bytesToBase64Url = (bytes: Uint8Array) => {
    let binary = "";
    bytes.forEach((byte) => {
      binary += String.fromCharCode(byte);
    });
    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
  };

  const randomIndex = (maximum: number) => {
    if (!Number.isInteger(maximum) || maximum < 1) {
      throw new Error("Character source cannot be empty.");
    }

    const limit = Math.floor(0x100000000 / maximum) * maximum;
    const buffer = new Uint32Array(1);
    let value = 0;

    do {
      crypto.getRandomValues(buffer);
      value = buffer[0] ?? 0;
    } while (value >= limit);

    return value % maximum;
  };

  const randomFromCharacters = (characters: string, length: number) => {
    if (!characters) throw new Error("Select at least one character group.");
    return Array.from({ length }, () => characters[randomIndex(characters.length)]).join("");
  };

  const wordList = [
    "amber","anchor","apple","arrow","atlas","autumn","bamboo","beacon","berry","birch",
    "breeze","bridge","brook","cactus","canyon","cedar","cherry","cloud","cobalt","comet",
    "coral","crystal","dawn","delta","desert","dolphin","dream","ember","falcon","fern",
    "field","fjord","forest","frost","galaxy","garden","glacier","harbor","hazel","honey",
    "island","ivy","jade","jungle","lagoon","lantern","lemon","lotus","lunar","maple",
    "meadow","meteor","mint","mist","moon","moss","mountain","nebula","oasis","ocean",
    "olive","onyx","opal","orchid","panda","pearl","pepper","pine","planet","plum",
    "prairie","quartz","raven","reef","river","robin","rose","saffron","sage","shadow",
    "silver","sky","solar","sparrow","spring","star","stone","storm","summit","sunset",
    "tiger","timber","topaz","tulip","valley","violet","wave","willow","winter","zephyr",
  ];

  const getPasswordScore = (value: string) => {
    let score = 0;
    const suggestions: string[] = [];

    if (value.length >= 12) score += 2;
    else if (value.length >= 8) score += 1;
    else suggestions.push("Use at least 12 characters.");

    const groups = [
      /[a-z]/.test(value),
      /[A-Z]/.test(value),
      /\d/.test(value),
      /[^A-Za-z0-9]/.test(value),
    ].filter(Boolean).length;

    score += Math.max(0, groups - 1);

    if (groups < 3) suggestions.push("Mix uppercase, lowercase, numbers and symbols.");
    if (/(.)\1{2,}/.test(value)) {
      score -= 1;
      suggestions.push("Avoid repeated characters.");
    }
    if (/password|qwerty|admin|letmein|welcome|123456/i.test(value)) {
      score = Math.min(score, 1);
      suggestions.push("Avoid common words and predictable patterns.");
    }

    score = Math.max(0, Math.min(5, score));
    const labels = ["Very weak", "Weak", "Fair", "Good", "Strong", "Very strong"];

    return {
      score,
      label: labels[score] ?? "Unknown",
      suggestions,
    };
  };

  const timingSafeStyleEqual = (left: string, right: string) => {
    const leftBytes = encoder.encode(left);
    const rightBytes = encoder.encode(right);
    const maximum = Math.max(leftBytes.length, rightBytes.length);
    let difference = leftBytes.length ^ rightBytes.length;

    for (let index = 0; index < maximum; index += 1) {
      difference |= (leftBytes[index] ?? 0) ^ (rightBytes[index] ?? 0);
    }

    return difference === 0;
  };

  function setupSecurityTools() {
    document.querySelectorAll<HTMLElement>("[data-security-tool]").forEach((root) => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const mode = root.dataset.mode ?? "";
      const isCompact = root.dataset.compact === "true";
      const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
      const secondary = root.querySelector<HTMLTextAreaElement>("[data-secondary]");
      const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
      const compactResult = root.querySelector<HTMLElement>("[data-compact-result]");
      const runButtons = root.querySelectorAll<HTMLButtonElement>("[data-run]");
      const copyButtons = root.querySelectorAll<HTMLButtonElement>("[data-copy]");
      const clearButtons = root.querySelectorAll<HTMLButtonElement>("[data-clear]");
      const statuses = root.querySelectorAll<HTMLElement>("[data-status]");
      const lengthInput = root.querySelector<HTMLInputElement>("[data-length]");
      const countInput = root.querySelector<HTMLInputElement>("[data-count]");
      const separatorInput = root.querySelector<HTMLInputElement>("[data-separator]");
      const algorithmInput = root.querySelector<HTMLSelectElement>("[data-algorithm]");
      const formatInput = root.querySelector<HTMLSelectElement>("[data-format]");
      const lowercase = root.querySelector<HTMLInputElement>("[data-lowercase]");
      const uppercase = root.querySelector<HTMLInputElement>("[data-uppercase]");
      const numbers = root.querySelector<HTMLInputElement>("[data-numbers]");
      const symbols = root.querySelector<HTMLInputElement>("[data-symbols]");
      const ignoreCase = root.querySelector<HTMLInputElement>("[data-ignore-case]");

      const fieldSecondary = root.querySelector<HTMLElement>('[data-field="secondary"]');
      const optionLength = root.querySelector<HTMLElement>('[data-option="length"]');
      const optionCount = root.querySelector<HTMLElement>('[data-option="count"]');
      const optionSeparator = root.querySelector<HTMLElement>('[data-option="separator"]');
      const optionAlgorithm = root.querySelector<HTMLElement>('[data-option="algorithm"]');
      const optionFormat = root.querySelector<HTMLElement>('[data-option="format"]');
      const characterOptions = root.querySelector<HTMLElement>("[data-character-options]");
      const caseOption = root.querySelector<HTMLElement>("[data-case-option]");
      const primaryLabel = root.querySelector<HTMLElement>("[data-primary-label]");
      const secondaryLabel = root.querySelector<HTMLElement>("[data-secondary-label]");

      let timer = 0;

      const show = (element: HTMLElement | null, display = "grid") => {
        element?.classList.remove("hidden");
        if (display === "flex") element?.classList.add("flex");
        else element?.classList.add("grid");
      };

      const hide = (element: HTMLElement | null) => {
        element?.classList.add("hidden");
        element?.classList.remove("grid", "flex");
      };

      hide(fieldSecondary);
      hide(optionCount);
      hide(optionSeparator);
      hide(optionAlgorithm);
      hide(optionFormat);
      hide(caseOption);

      if (mode === "passphrase-generator") {
        hide(optionLength);
        hide(characterOptions);
        show(optionCount);
        show(optionSeparator);
        if (input) input.closest("label")?.classList.add("hidden");
      } else if (mode === "secure-token-generator") {
        hide(characterOptions);
        show(optionFormat);
        if (lengthInput) {
          lengthInput.value = "32";
          lengthInput.max = "1024";
        }
        if (input) input.closest("label")?.classList.add("hidden");
      } else if (mode === "password-generator" || mode === "random-string-generator") {
        if (input) input.closest("label")?.classList.add("hidden");
      } else {
        hide(optionLength);
        hide(characterOptions);
      }

      if (mode === "hmac-generator") {
        show(fieldSecondary);
        show(optionAlgorithm);
        if (primaryLabel) primaryLabel.textContent = "Message";
        if (secondaryLabel) secondaryLabel.textContent = "Secret key";
        if (secondary) secondary.placeholder = "Enter secret key…";
      }

      if (mode === "basic-auth-generator") {
        show(fieldSecondary);
        if (primaryLabel) primaryLabel.textContent = "Username";
        if (secondaryLabel) secondaryLabel.textContent = "Password";
        if (input) input.placeholder = "Enter username…";
        if (secondary) secondary.placeholder = "Enter password…";
      }

      if (mode === "hash-compare") {
        show(fieldSecondary);
        show(caseOption, "flex");
        if (primaryLabel) primaryLabel.textContent = "First hash";
        if (secondaryLabel) secondaryLabel.textContent = "Second hash";
        if (input) input.placeholder = "Paste first hash…";
        if (secondary) secondary.placeholder = "Paste second hash…";
      }

      if (mode === "password-strength-checker") {
        if (primaryLabel) primaryLabel.textContent = "Password";
        if (input) input.placeholder = "Enter a password to evaluate…";
      }

      const showStatus = (message: string, error = false) => {
        window.clearTimeout(timer);
        statuses.forEach((status) => {
          status.textContent = message;
          status.classList.toggle("text-red-400", error);
          status.classList.toggle("text-emerald-400", !error);
          status.classList.remove("opacity-0");
          status.classList.add("opacity-100");
        });
        timer = window.setTimeout(() => {
          statuses.forEach((status) => {
            status.classList.remove("opacity-100");
            status.classList.add("opacity-0");
          });
        }, 1800);
      };

      const flash = (buttons: NodeListOf<HTMLButtonElement>, label: string) => {
        buttons.forEach((button) => {
          const original = button.textContent ?? "";
          button.textContent = label;
          button.classList.add("ring-2", "ring-emerald-400/60");
          window.setTimeout(() => {
            button.textContent = original;
            button.classList.remove("ring-2", "ring-emerald-400/60");
          }, 900);
        });
      };

      const setResult = (value: string, positive = true) => {
        if (output) output.value = value;
        if (compactResult) {
          compactResult.textContent = value;
          compactResult.classList.toggle("border-emerald-400/30", positive);
          compactResult.classList.toggle("bg-emerald-500/10", positive);
          compactResult.classList.toggle("text-emerald-300", positive);
          compactResult.classList.toggle("border-red-400/30", !positive);
          compactResult.classList.toggle("bg-red-500/10", !positive);
          compactResult.classList.toggle("text-red-300", !positive);
          compactResult.classList.remove("text-zinc-400");
        }
      };

      const readLength = (minimum: number, maximum: number) => {
        const value = Number.parseInt(lengthInput?.value ?? "", 10);
        if (!Number.isInteger(value) || value < minimum || value > maximum) {
          throw new Error(`Length must be between ${minimum} and ${maximum}.`);
        }
        return value;
      };

      const getCharacters = () => {
        let characters = "";
        if (lowercase?.checked) characters += "abcdefghijklmnopqrstuvwxyz";
        if (uppercase?.checked) characters += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        if (numbers?.checked) characters += "0123456789";
        if (symbols?.checked) characters += "!@#$%^&*()-_=+[]{};:,.?";
        return characters;
      };

      const process = async () => {
        try {
          let result = "";
          let positive = true;

          switch (mode) {
            case "password-generator":
            case "random-string-generator":
              result = randomFromCharacters(getCharacters(), readLength(4, 4096));
              break;

            case "passphrase-generator": {
              const count = Number.parseInt(countInput?.value ?? "", 10);
              if (!Number.isInteger(count) || count < 3 || count > 12) {
                throw new Error("Word count must be between 3 and 12.");
              }
              const separator = separatorInput?.value ?? "-";
              result = Array.from({ length: count }, () => wordList[randomIndex(wordList.length)]).join(separator);
              break;
            }

            case "secure-token-generator": {
              const byteLength = readLength(8, 1024);
              const bytes = crypto.getRandomValues(new Uint8Array(byteLength));
              result = formatInput?.value === "base64url" ? bytesToBase64Url(bytes) : bytesToHex(bytes);
              break;
            }

            case "password-strength-checker": {
              const value = input?.value ?? "";
              if (!value) throw new Error("Enter a password to evaluate.");
              const assessment = getPasswordScore(value);
              result = [
                `Strength: ${assessment.label}`,
                `Score: ${assessment.score}/5`,
                `Length: ${value.length}`,
                assessment.suggestions.length
                  ? `Suggestions:\n- ${assessment.suggestions.join("\n- ")}`
                  : "Suggestions: No obvious weakness detected by this estimator.",
              ].join("\n");
              positive = assessment.score >= 3;
              break;
            }

            case "sha256-hash-generator":
            case "sha512-hash-generator": {
              const value = input?.value ?? "";
              const algorithm = mode === "sha256-hash-generator" ? "SHA-256" : "SHA-512";
              const digest = await crypto.subtle.digest(algorithm, encoder.encode(value));
              result = bytesToHex(new Uint8Array(digest));
              break;
            }

            case "hmac-generator": {
              const message = input?.value ?? "";
              const secret = secondary?.value ?? "";
              if (!secret) throw new Error("Enter a secret key.");
              const algorithm = algorithmInput?.value === "SHA-512" ? "SHA-512" : "SHA-256";
              const key = await crypto.subtle.importKey(
                "raw",
                encoder.encode(secret),
                { name: "HMAC", hash: algorithm },
                false,
                ["sign"],
              );
              const signature = await crypto.subtle.sign("HMAC", key, encoder.encode(message));
              result = bytesToHex(new Uint8Array(signature));
              break;
            }

            case "basic-auth-generator": {
              const username = input?.value ?? "";
              const password = secondary?.value ?? "";
              if (!username) throw new Error("Enter a username.");
              const encoded = bytesToBase64Url(encoder.encode(`${username}:${password}`))
                .replace(/-/g, "+")
                .replace(/_/g, "/");
              const padding = "=".repeat((4 - (encoded.length % 4)) % 4);
              result = `Authorization: Basic ${encoded}${padding}`;
              break;
            }

            case "hash-compare": {
              let left = (input?.value ?? "").trim();
              let right = (secondary?.value ?? "").trim();
              if (!left || !right) throw new Error("Enter both hashes.");
              if (ignoreCase?.checked) {
                left = left.toLowerCase();
                right = right.toLowerCase();
              }
              const matches = timingSafeStyleEqual(left, right);
              result = matches ? "Match: the two values are identical." : "No match: the two values are different.";
              positive = matches;
              break;
            }
          }

          setResult(result, positive);
          flash(runButtons, "Processed");
          showStatus("Result updated");
        } catch (error) {
          const message = error instanceof Error ? error.message : "Unable to process input.";
          if (output) output.value = "";
          if (isCompact) setResult(message, false);
          showStatus(message, true);
        }
      };

      runButtons.forEach((button) => button.addEventListener("click", process));

      copyButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const value = output?.value ?? "";
          if (!value) {
            showStatus("Nothing to copy", true);
            return;
          }
          await navigator.clipboard.writeText(value);
          flash(copyButtons, "Copied!");
          showStatus("Copied to clipboard");
        });
      });

      clearButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (input) input.value = "";
          if (secondary) secondary.value = "";
          if (output) output.value = "";
          if (compactResult) {
            compactResult.textContent = "Enter data and select Process.";
            compactResult.className =
              "min-h-20 whitespace-pre-wrap rounded-2xl border border-white/10 bg-zinc-950/70 px-5 py-4 font-mono text-sm leading-6 text-zinc-400";
          }
          flash(clearButtons, "Cleared");
          showStatus("All fields cleared");
          input?.focus();
        });
      });
    });
  }

  setupSecurityTools();
  document.addEventListener("astro:page-load", setupSecurityTools);
</script>
