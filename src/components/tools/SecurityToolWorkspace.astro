---
interface Props { mode: string; }
const { mode } = Astro.props;
const generatorModes = new Set(["password-generator","passphrase-generator","random-string-generator","secure-token-generator"]);
const isGenerator = generatorModes.has(mode);
const isCompact = mode === "password-strength-checker" || mode === "hash-compare";
const actionLabel = mode === "password-generator" ? "Generate password" : mode === "passphrase-generator" ? "Generate passphrase" : mode === "random-string-generator" ? "Generate string" : mode === "secure-token-generator" ? "Generate token" : "Generate";
---
<section class="overflow-hidden rounded-3xl border border-white/10 bg-zinc-900/80 shadow-2xl shadow-black/20" data-security-tool data-mode={mode} data-generator={isGenerator ? "true" : "false"} data-compact={isCompact ? "true" : "false"}>
  <div class="p-4 sm:p-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-zinc-500">{isGenerator ? "Generated locally in your browser." : "Updates automatically in your browser."}</p>
      <div class="flex flex-wrap items-center gap-2"><span data-status class="min-w-20 text-right text-sm font-medium text-emerald-400 opacity-0 transition-opacity" aria-live="polite"></span>{isGenerator && <button data-generate type="button" class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">{actionLabel}</button>}<button data-copy type="button" class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-brand-400/40 hover:bg-white/5">Copy result</button><button data-clear type="button" class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200">Clear</button></div>
    </div>

    <div class="grid gap-4">
      <label data-primary-field class="grid gap-2 text-sm text-zinc-300">Input<textarea data-input class="focus-ring min-h-40 rounded-2xl border border-white/10 bg-zinc-950 p-5 font-mono text-sm leading-7 text-zinc-100" placeholder="Enter input…"></textarea></label>
      <label data-secondary-field class="hidden gap-2 text-sm text-zinc-300">Second value<textarea data-secondary class="focus-ring min-h-28 rounded-2xl border border-white/10 bg-zinc-950 p-5 font-mono text-sm leading-7 text-zinc-100"></textarea></label>
      <div data-generator-options class="hidden grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <label data-length-field class="grid gap-2 text-sm text-zinc-300">Length<input data-length type="number" min="4" max="4096" value="24" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3" /></label>
        <label data-count-field class="hidden gap-2 text-sm text-zinc-300">Word count<input data-count type="number" min="3" max="12" value="5" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3" /></label>
        <label data-separator-field class="hidden gap-2 text-sm text-zinc-300">Separator<input data-separator value="-" maxlength="8" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3" /></label>
        <label data-format-field class="hidden gap-2 text-sm text-zinc-300">Format<select data-format class="focus-ring cursor-pointer rounded-xl border border-white/10 bg-zinc-950 px-4 py-3"><option value="hex">Hexadecimal</option><option value="base64url">Base64 URL-safe</option></select></label>
      </div>
      <div data-char-options class="hidden flex-wrap gap-4 text-sm text-zinc-300"><label><input data-lower type="checkbox" checked /> Lowercase</label><label><input data-upper type="checkbox" checked /> Uppercase</label><label><input data-number type="checkbox" checked /> Numbers</label><label><input data-symbol type="checkbox" checked /> Symbols</label></div>
      <label data-algorithm-field class="hidden max-w-xs gap-2 text-sm text-zinc-300">Algorithm<select data-algorithm class="focus-ring cursor-pointer rounded-xl border border-white/10 bg-zinc-950 px-4 py-3"><option>SHA-256</option><option>SHA-512</option></select></label>
      <label data-case-field class="hidden items-center gap-2 text-sm text-zinc-300"><input data-ignore-case type="checkbox" checked /> Ignore letter case</label>
    </div>

    <div class="mt-4">{isCompact ? <div class="grid gap-2 text-sm text-zinc-300">Result<div data-compact-result class="min-h-20 whitespace-pre-wrap rounded-2xl border border-white/10 bg-zinc-950/70 px-5 py-4 font-mono text-sm leading-6 text-zinc-400">Enter data to check.</div><textarea data-output class="hidden" readonly></textarea></div> : <label class="grid gap-2 text-sm text-zinc-300">Result<textarea data-output readonly class="focus-ring min-h-48 rounded-2xl border border-white/10 bg-zinc-950/70 p-5 font-mono text-sm leading-7 text-zinc-100"></textarea></label>}</div>
    <div class="mt-3 flex justify-end gap-2">{isGenerator && <button data-generate type="button" class="focus-ring cursor-pointer rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">{actionLabel}</button>}<button data-copy type="button" class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-brand-400/40 hover:bg-white/5">Copy result</button><button data-clear type="button" class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200">Clear</button></div>
  </div>
</section>

<script>
  const enc=new TextEncoder(); const hex=(b:Uint8Array)=>Array.from(b,x=>x.toString(16).padStart(2,"0")).join(""); const b64url=(b:Uint8Array)=>{let s="";b.forEach(x=>s+=String.fromCharCode(x));return btoa(s).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/g,"");};
  const randomIndex=(max:number)=>{const a=new Uint32Array(1),limit=Math.floor(0x100000000/max)*max;let v=0;do{crypto.getRandomValues(a);v=a[0]??0;}while(v>=limit);return v%max;};
  const words="amber anchor apple arrow atlas autumn bamboo beacon berry birch breeze bridge brook cactus canyon cedar cherry cloud cobalt comet coral crystal dawn delta desert dolphin dream ember falcon fern field fjord forest frost galaxy garden glacier harbor hazel honey island ivy jade jungle lagoon lantern lemon lotus lunar maple meadow meteor mint mist moon moss mountain nebula oasis ocean olive onyx opal orchid panda pearl pepper pine planet plum prairie quartz raven reef river robin rose saffron sage shadow silver sky solar sparrow spring star stone storm summit sunset tiger timber topaz tulip valley violet wave willow winter zephyr".split(" ");
  const equal=(a:string,b:string)=>{const x=enc.encode(a),y=enc.encode(b),m=Math.max(x.length,y.length);let d=x.length^y.length;for(let i=0;i<m;i++)d|=(x[i]??0)^(y[i]??0);return d===0;};
  const strength=(v:string)=>{let s=0;const tips:string[]=[];if(v.length>=12)s+=2;else if(v.length>=8)s++;else tips.push("Use at least 12 characters.");const groups=[/[a-z]/.test(v),/[A-Z]/.test(v),/\d/.test(v),/[^A-Za-z0-9]/.test(v)].filter(Boolean).length;s+=Math.max(0,groups-1);if(groups<3)tips.push("Mix several character types.");if(/password|qwerty|admin|letmein|123456/i.test(v)){s=Math.min(s,1);tips.push("Avoid common passwords.");}s=Math.max(0,Math.min(5,s));return {s,label:["Very weak","Weak","Fair","Good","Strong","Very strong"][s],tips};};
  function setup(){document.querySelectorAll<HTMLElement>("[data-security-tool]").forEach(root=>{if(root.dataset.initialized==="true")return;root.dataset.initialized="true";const mode=root.dataset.mode??"",generator=root.dataset.generator==="true";const input=root.querySelector<HTMLTextAreaElement>("[data-input]"),secondary=root.querySelector<HTMLTextAreaElement>("[data-secondary]"),output=root.querySelector<HTMLTextAreaElement>("[data-output]"),compact=root.querySelector<HTMLElement>("[data-compact-result]"),status=root.querySelector<HTMLElement>("[data-status]");const primaryField=root.querySelector<HTMLElement>("[data-primary-field]"),secondaryField=root.querySelector<HTMLElement>("[data-secondary-field]"),genOptions=root.querySelector<HTMLElement>("[data-generator-options]"),lenField=root.querySelector<HTMLElement>("[data-length-field]"),countField=root.querySelector<HTMLElement>("[data-count-field]"),sepField=root.querySelector<HTMLElement>("[data-separator-field]"),formatField=root.querySelector<HTMLElement>("[data-format-field]"),chars=root.querySelector<HTMLElement>("[data-char-options]"),algField=root.querySelector<HTMLElement>("[data-algorithm-field]"),caseField=root.querySelector<HTMLElement>("[data-case-field]");const length=root.querySelector<HTMLInputElement>("[data-length]"),count=root.querySelector<HTMLInputElement>("[data-count]"),separator=root.querySelector<HTMLInputElement>("[data-separator]"),format=root.querySelector<HTMLSelectElement>("[data-format]"),algorithm=root.querySelector<HTMLSelectElement>("[data-algorithm]"),ignoreCase=root.querySelector<HTMLInputElement>("[data-ignore-case]");const lower=root.querySelector<HTMLInputElement>("[data-lower]"),upper=root.querySelector<HTMLInputElement>("[data-upper]"),number=root.querySelector<HTMLInputElement>("[data-number]"),symbol=root.querySelector<HTMLInputElement>("[data-symbol]");const generate=root.querySelectorAll<HTMLButtonElement>("[data-generate]"),copies=root.querySelectorAll<HTMLButtonElement>("[data-copy]"),clears=root.querySelectorAll<HTMLButtonElement>("[data-clear]");let timer: ReturnType<typeof setTimeout> | undefined; let debounce: ReturnType<typeof setTimeout> | undefined;
    const show=(e:HTMLElement|null,display="grid")=>{e?.classList.remove("hidden");e?.classList.add(display);}; const hide=(e:HTMLElement|null)=>e?.classList.add("hidden");
    if(generator){hide(primaryField);show(genOptions);if(mode==="password-generator"||mode==="random-string-generator")show(chars,"flex");if(mode==="passphrase-generator"){hide(lenField);show(countField);show(sepField);}if(mode==="secure-token-generator"){show(formatField);if(length){length.value="32";length.min="8";}}}
    if(mode==="hmac-generator"||mode==="basic-auth-generator"||mode==="hash-compare")show(secondaryField);if(mode==="hmac-generator")show(algField);if(mode==="hash-compare")show(caseField,"flex");
    const notify=(m:string,bad=false)=>{if(!status)return;status.textContent=m;status.classList.toggle("text-red-400",bad);status.classList.toggle("text-emerald-400",!bad);status.classList.replace("opacity-0","opacity-100");if (timer) clearTimeout(timer); timer=setTimeout(()=>status.classList.replace("opacity-100","opacity-0"),1200);};
    const setResult=(v:string,bad=false)=>{if(output)output.value=v;if(compact){compact.textContent=v||"Enter data to check.";compact.classList.toggle("text-red-300",bad);compact.classList.toggle("text-emerald-300",!bad&&!!v);compact.classList.toggle("text-zinc-400",!v);}};
    const update=async()=>{if(generator)return;const a=input?.value??"",b=secondary?.value??"";if(!a&&!b){setResult("");return;}try{let r="",positive=true;switch(mode){case"password-strength-checker":{const x=strength(a);r=`Strength: ${x.label}\nScore: ${x.s}/5\nLength: ${a.length}\n${x.tips.length?`Suggestions:\n- ${x.tips.join("\n- ")}`:"No obvious weakness detected by this estimator."}`;positive=x.s>=3;break;}case"sha256-hash-generator":case"sha512-hash-generator":{const alg=mode.startsWith("sha256")?"SHA-256":"SHA-512";r=hex(new Uint8Array(await crypto.subtle.digest(alg,enc.encode(a))));break;}case"hmac-generator":{if(!b)throw new Error("Enter a secret key.");const alg=algorithm?.value==="SHA-512"?"SHA-512":"SHA-256",key=await crypto.subtle.importKey("raw",enc.encode(b),{name:"HMAC",hash:alg},false,["sign"]);r=hex(new Uint8Array(await crypto.subtle.sign("HMAC",key,enc.encode(a))));break;}case"basic-auth-generator":{if(!a)throw new Error("Enter a username.");let raw="";enc.encode(`${a}:${b}`).forEach(x=>raw+=String.fromCharCode(x));r=`Authorization: Basic ${btoa(raw)}`;break;}case"hash-compare":{if(!a||!b)throw new Error("Enter both hashes.");const x=ignoreCase?.checked?a.trim().toLowerCase():a.trim(),y=ignoreCase?.checked?b.trim().toLowerCase():b.trim();positive=equal(x,y);r=positive?"Match: the two values are identical.":"No match: the two values are different.";break;}}setResult(r,!positive);}catch(e){setResult(e instanceof Error?e.message:"Unable to process input.",true);}};
    [input,secondary].forEach(e=>e?.addEventListener("input",()=>{if (debounce) clearTimeout(debounce); debounce=setTimeout(update,180);}));algorithm?.addEventListener("change",update);ignoreCase?.addEventListener("change",update);
    generate.forEach(button=>button.addEventListener("click",()=>{try{let r="";if(mode==="passphrase-generator"){const n=Number(count?.value??5);if(!Number.isInteger(n)||n<3||n>12)throw new Error("Word count must be 3 to 12.");r=Array.from({length:n},()=>words[randomIndex(words.length)]).join(separator?.value??"-");}else if(mode==="secure-token-generator"){const n=Number(length?.value??32);if(!Number.isInteger(n)||n<8||n>1024)throw new Error("Length must be 8 to 1024 bytes.");const bytes=crypto.getRandomValues(new Uint8Array(n));r=format?.value==="base64url"?b64url(bytes):hex(bytes);}else{const n=Number(length?.value??24);if(!Number.isInteger(n)||n<4||n>4096)throw new Error("Length must be 4 to 4096.");let set="";if(lower?.checked)set+="abcdefghijklmnopqrstuvwxyz";if(upper?.checked)set+="ABCDEFGHIJKLMNOPQRSTUVWXYZ";if(number?.checked)set+="0123456789";if(symbol?.checked)set+="!@#$%^&*()-_=+[]{};:,.?";if(!set)throw new Error("Select at least one character group.");r=Array.from({length:n},()=>set[randomIndex(set.length)]).join("");}setResult(r);notify("Generated");}catch(e){notify(e instanceof Error?e.message:"Unable to generate",true);}}));
    copies.forEach(b=>b.addEventListener("click",async()=>{if(!output?.value)return notify("Nothing to copy",true);await navigator.clipboard.writeText(output.value);notify("Copied");}));clears.forEach(b=>b.addEventListener("click",()=>{if(input)input.value="";if(secondary)secondary.value="";setResult("");notify("Cleared");}));
  });}
  setup();document.addEventListener("astro:page-load",setup);
</script>
