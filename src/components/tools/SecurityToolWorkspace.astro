---
interface Props { mode: string; }
const { mode } = Astro.props;
const generators = new Set(["password-generator","passphrase-generator","random-string-generator","secure-token-generator"]);
const hashes = new Set(["sha256-hash-generator","sha512-hash-generator"]);
const isGenerator = generators.has(mode);
const isHash = hashes.has(mode);
const actionLabel = mode === "password-generator" ? "Generate password" : mode === "passphrase-generator" ? "Generate passphrase" : mode === "random-string-generator" ? "Generate string" : "Generate token";
---

<section class="overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/80 shadow-xl shadow-black/20" data-security-tool data-mode={mode}>
  <div class="p-3 sm:p-4">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2.5">
      <p class="text-xs text-zinc-500">{isGenerator ? "Generated locally in your browser." : "Updates automatically in your browser."}</p>
      <div class="flex flex-wrap items-center gap-2">
        <span data-status class="min-w-20 text-right text-xs font-medium text-emerald-400 opacity-0 transition-opacity" aria-live="polite"></span>
        {isGenerator && <button type="button" data-generate class="focus-ring rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white hover:bg-brand-500">{actionLabel}</button>}
        <button type="button" data-copy class="focus-ring rounded-lg border border-white/10 px-3 py-2 text-sm font-medium hover:bg-white/5">Copy result</button>
        <button type="button" data-clear class="focus-ring rounded-lg border border-white/10 px-3 py-2 text-sm font-medium hover:border-red-400/40 hover:bg-red-500/10">Clear</button>
      </div>
    </div>

    {isGenerator && (
      <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)]">
        <div class="grid content-start gap-3 rounded-xl border border-white/10 bg-zinc-950/35 p-4">
          {mode !== "passphrase-generator" && <label class="grid gap-1.5 text-sm text-zinc-300">Length<input data-length type="number" min={mode === "secure-token-generator" ? 8 : 4} max={mode === "secure-token-generator" ? 1024 : 4096} value={mode === "secure-token-generator" ? 32 : 24} class="focus-ring rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5" /></label>}
          {mode === "passphrase-generator" && <><label class="grid gap-1.5 text-sm text-zinc-300">Word count<input data-count type="number" min="3" max="12" value="5" class="focus-ring rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5" /></label><label class="grid gap-1.5 text-sm text-zinc-300">Separator<input data-separator value="-" maxlength="8" class="focus-ring rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5" /></label></>}
          {(mode === "password-generator" || mode === "random-string-generator") && <div class="flex flex-wrap gap-3 text-sm text-zinc-300"><label><input data-lower type="checkbox" checked /> Lowercase</label><label><input data-upper type="checkbox" checked /> Uppercase</label><label><input data-number type="checkbox" checked /> Numbers</label><label><input data-symbol type="checkbox" checked /> Symbols</label></div>}
          {mode === "secure-token-generator" && <label class="grid gap-1.5 text-sm text-zinc-300">Format<select data-format class="focus-ring rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5"><option value="hex">Hexadecimal</option><option value="base64url">Base64 URL-safe</option></select></label>}
        </div>
        <label class="grid gap-1.5 text-sm text-zinc-300">Generated result<textarea data-output readonly class="focus-ring min-h-[11rem] resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 font-mono text-sm leading-6 text-zinc-100"></textarea></label>
      </div>
    )}

    {isHash && (
      <div class="grid gap-3 lg:grid-cols-[minmax(0,1.25fr)_minmax(20rem,0.75fr)]">
        <label class="grid gap-1.5 text-sm text-zinc-300">Input text<textarea data-input class="focus-ring min-h-[clamp(11rem,28vh,18rem)] resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 text-sm leading-6 text-zinc-100" placeholder="Type or paste text…"></textarea></label>
        <div class="grid content-start gap-1.5 text-sm text-zinc-300"><span>{mode === "sha256-hash-generator" ? "SHA-256 digest" : "SHA-512 digest"}</span><div data-result-card class="min-h-24 break-all rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6 text-zinc-100">Enter text to generate a digest.</div><textarea data-output class="hidden" readonly></textarea></div>
      </div>
    )}

    {mode === "basic-auth-generator" && (
      <div class="grid gap-3 lg:grid-cols-[minmax(0,0.9fr)_minmax(20rem,1.1fr)]">
        <div class="grid content-start gap-3 rounded-xl border border-white/10 bg-zinc-950/35 p-4"><label class="grid gap-1.5 text-sm text-zinc-300">Username<input data-input class="focus-ring rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5" placeholder="username" /></label><label class="grid gap-1.5 text-sm text-zinc-300">Password<input data-secondary type="password" class="focus-ring rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5" placeholder="password" /></label><label class="flex items-center gap-2 text-xs text-zinc-400"><input data-show-secret type="checkbox" /> Show password</label></div>
        <div class="grid content-start gap-1.5 text-sm text-zinc-300"><span>Authorization header</span><div data-result-card class="min-h-28 break-all rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6 text-zinc-100">Enter a username and password.</div><textarea data-output class="hidden" readonly></textarea></div>
      </div>
    )}

    {mode === "hmac-generator" && (
      <div class="grid gap-3 lg:grid-cols-2">
        <div class="grid gap-3"><label class="grid gap-1.5 text-sm text-zinc-300">Message<textarea data-input class="focus-ring min-h-[10rem] resize-y rounded-xl border border-white/10 bg-zinc-950 p-4 text-sm leading-6" placeholder="Message to sign…"></textarea></label><div class="grid gap-3 sm:grid-cols-[1fr_10rem]"><label class="grid gap-1.5 text-sm text-zinc-300">Secret key<input data-secondary type="password" class="focus-ring rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5" /></label><label class="grid gap-1.5 text-sm text-zinc-300">Algorithm<select data-algorithm class="focus-ring rounded-lg border border-white/10 bg-zinc-950 px-3 py-2.5"><option>SHA-256</option><option>SHA-512</option></select></label></div></div>
        <div class="grid content-start gap-1.5 text-sm text-zinc-300"><span>HMAC signature</span><div data-result-card class="min-h-[10rem] break-all rounded-xl border border-white/10 bg-zinc-950/70 p-4 font-mono text-sm leading-6 text-zinc-100">Enter a message and secret key.</div><textarea data-output class="hidden" readonly></textarea></div>
      </div>
    )}

    {mode === "password-strength-checker" && (
      <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_22rem]"><div class="grid content-start gap-3"><label class="grid gap-1.5 text-sm text-zinc-300">Password<input data-input type="password" class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3" placeholder="Enter a password…" /></label><label class="flex items-center gap-2 text-xs text-zinc-400"><input data-show-secret type="checkbox" /> Show password</label></div><div><div class="mb-2 flex items-center justify-between text-sm"><span class="text-zinc-400">Strength</span><strong data-strength-label class="text-zinc-200">Waiting</strong></div><div class="h-2 overflow-hidden rounded-full bg-white/5"><div data-strength-bar class="h-full w-0 rounded-full bg-zinc-600 transition-all"></div></div><div data-result-card class="mt-3 min-h-24 whitespace-pre-wrap rounded-xl border border-white/10 bg-zinc-950/70 p-4 text-sm leading-6 text-zinc-400">Enter a password to evaluate.</div><textarea data-output class="hidden" readonly></textarea></div></div>
    )}

    {mode === "hash-compare" && (
      <div class="grid gap-3"><div class="grid gap-3 lg:grid-cols-2"><label class="grid gap-1.5 text-sm text-zinc-300">First hash<input data-input class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 font-mono text-sm" /></label><label class="grid gap-1.5 text-sm text-zinc-300">Second hash<input data-secondary class="focus-ring rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 font-mono text-sm" /></label></div><label class="flex items-center gap-2 text-xs text-zinc-400"><input data-ignore-case type="checkbox" checked /> Ignore letter case</label><div data-result-card class="rounded-xl border border-white/10 bg-zinc-950/70 p-4 text-sm text-zinc-400">Enter both hashes to compare.</div><textarea data-output class="hidden" readonly></textarea></div>
    )}
  </div>
</section>

<script>
  const encoder=new TextEncoder();
  const hex=(bytes:Uint8Array)=>Array.from(bytes,b=>b.toString(16).padStart(2,"0")).join("");
  const base64Url=(bytes:Uint8Array)=>{let raw="";bytes.forEach(b=>raw+=String.fromCharCode(b));return btoa(raw).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/g,"");};
  const randomIndex=(max:number)=>{const values=new Uint32Array(1),limit=Math.floor(0x100000000/max)*max;let value=0;do{crypto.getRandomValues(values);value=values[0]??0;}while(value>=limit);return value%max;};
  const words="amber anchor apple arrow atlas autumn bamboo beacon berry birch breeze bridge brook cactus canyon cedar cherry cloud cobalt comet coral crystal dawn delta desert dolphin dream ember falcon fern field fjord forest frost galaxy garden glacier harbor hazel honey island ivy jade jungle lagoon lantern lemon lotus lunar maple meadow meteor mint mist moon moss mountain nebula oasis ocean olive onyx opal orchid panda pearl pepper pine planet plum prairie quartz raven reef river robin rose saffron sage shadow silver sky solar sparrow spring star stone storm summit sunset tiger timber topaz tulip valley violet wave willow winter zephyr".split(" ");
  const equal=(a:string,b:string)=>{const x=encoder.encode(a),y=encoder.encode(b);let diff=x.length^y.length;for(let i=0;i<Math.max(x.length,y.length);i++)diff|=(x[i]??0)^(y[i]??0);return diff===0;};
  const assess=(value:string)=>{let score=0;const tips:string[]=[];if(value.length>=12)score+=2;else if(value.length>=8)score+=1;else tips.push("Use at least 12 characters.");const groups=[/[a-z]/.test(value),/[A-Z]/.test(value),/\d/.test(value),/[^A-Za-z0-9]/.test(value)].filter(Boolean).length;score+=Math.max(0,groups-1);if(groups<3)tips.push("Mix uppercase, lowercase, numbers and symbols.");if(/password|qwerty|admin|letmein|123456/i.test(value)){score=Math.min(score,1);tips.push("Avoid common words and predictable patterns.");}score=Math.max(0,Math.min(5,score));return {score,label:["Very weak","Weak","Fair","Good","Strong","Very strong"][score]??"Unknown",tips};};

  function setup(){document.querySelectorAll<HTMLElement>("[data-security-tool]").forEach(root=>{if(root.dataset.initialized==="true")return;root.dataset.initialized="true";const mode=root.dataset.mode??"";const input=root.querySelector<HTMLInputElement|HTMLTextAreaElement>("[data-input]"),secondary=root.querySelector<HTMLInputElement|HTMLTextAreaElement>("[data-secondary]"),output=root.querySelector<HTMLTextAreaElement>("[data-output]"),card=root.querySelector<HTMLElement>("[data-result-card]"),status=root.querySelector<HTMLElement>("[data-status]"),algorithm=root.querySelector<HTMLSelectElement>("[data-algorithm]"),ignoreCase=root.querySelector<HTMLInputElement>("[data-ignore-case]");let timer:ReturnType<typeof setTimeout>|undefined,debounce:ReturnType<typeof setTimeout>|undefined;
    const notify=(message:string,bad=false)=>{if(!status)return;status.textContent=message;status.classList.toggle("text-red-400",bad);status.classList.toggle("text-emerald-400",!bad);status.classList.replace("opacity-0","opacity-100");if(timer)clearTimeout(timer);timer=setTimeout(()=>status.classList.replace("opacity-100","opacity-0"),1200);};
    const setResult=(value:string,state:"neutral"|"success"|"error"="neutral")=>{if(output)output.value=value;if(card){card.textContent=value||"Waiting for input.";card.classList.remove("semantic-success","semantic-error","text-zinc-400");if(state==="success")card.classList.add("semantic-success");else if(state==="error")card.classList.add("semantic-error");else card.classList.add("text-zinc-400");}};
    const update=async()=>{const a=input?.value??"",b=secondary?.value??"";try{if(mode==="sha256-hash-generator"||mode==="sha512-hash-generator"){if(!a)return setResult("Enter text to generate a digest.");const digest=await crypto.subtle.digest(mode.startsWith("sha256")?"SHA-256":"SHA-512",encoder.encode(a));return setResult(hex(new Uint8Array(digest)),"success");}if(mode==="basic-auth-generator"){if(!a&&!b)return setResult("Enter a username and password.");let raw="";encoder.encode(`${a}:${b}`).forEach(byte=>raw+=String.fromCharCode(byte));return setResult(`Authorization: Basic ${btoa(raw)}`,"success");}if(mode==="hmac-generator"){if(!a&&!b)return setResult("Enter a message and secret key.");if(!b)return setResult("Enter a secret key.","error");const alg=algorithm?.value==="SHA-512"?"SHA-512":"SHA-256";const key=await crypto.subtle.importKey("raw",encoder.encode(b),{name:"HMAC",hash:alg},false,["sign"]);const signature=await crypto.subtle.sign("HMAC",key,encoder.encode(a));return setResult(hex(new Uint8Array(signature)),"success");}if(mode==="password-strength-checker"){if(!a){setResult("Enter a password to evaluate.");const label=root.querySelector<HTMLElement>("[data-strength-label]");const bar=root.querySelector<HTMLElement>("[data-strength-bar]");if(label)label.textContent="Waiting";if(bar){bar.style.width="0%";bar.className="h-full w-0 rounded-full bg-zinc-600 transition-all";}return;}const result=assess(a);const text=[`Strength: ${result.label}`,`Score: ${result.score}/5`,result.tips.length?`Suggestions:\n- ${result.tips.join("\n- ")}`:"No obvious weakness detected by this estimator."].join("\n");setResult(text,result.score>=3?"success":"error");const label=root.querySelector<HTMLElement>("[data-strength-label]");const bar=root.querySelector<HTMLElement>("[data-strength-bar]");if(label)label.textContent=result.label;if(bar){bar.style.width=`${result.score*20}%`;bar.className=`h-full rounded-full transition-all ${result.score>=4?"bg-emerald-500":result.score>=2?"bg-amber-500":"bg-red-500"}`;}return;}if(mode==="hash-compare"){if(!a&&!b)return setResult("Enter both hashes to compare.");if(!a||!b)return setResult("Enter both hashes.","error");const left=ignoreCase?.checked?a.trim().toLowerCase():a.trim(),right=ignoreCase?.checked?b.trim().toLowerCase():b.trim();const matches=equal(left,right);return setResult(matches?"Match: the two values are identical.":"No match: the values are different.",matches?"success":"error");}}catch(error){setResult(error instanceof Error?error.message:"Unable to process input.","error");}};
    [input,secondary].forEach(el=>el?.addEventListener("input",()=>{if(debounce)clearTimeout(debounce);debounce=setTimeout(update,160);}));algorithm?.addEventListener("change",update);ignoreCase?.addEventListener("change",update);
    root.querySelectorAll<HTMLInputElement>("[data-show-secret]").forEach(toggle=>toggle.addEventListener("change",()=>{const secret=secondary??input;if(secret instanceof HTMLInputElement)secret.type=toggle.checked?"text":"password";}));
    root.querySelectorAll<HTMLButtonElement>("[data-generate]").forEach(button=>button.addEventListener("click",()=>{try{let result="";if(mode==="passphrase-generator"){const count=Number(root.querySelector<HTMLInputElement>("[data-count]")?.value??5);if(!Number.isInteger(count)||count<3||count>12)throw new Error("Word count must be 3 to 12.");result=Array.from({length:count},()=>words[randomIndex(words.length)]).join(root.querySelector<HTMLInputElement>("[data-separator]")?.value??"-");}else if(mode==="secure-token-generator"){const length=Number(root.querySelector<HTMLInputElement>("[data-length]")?.value??32);if(!Number.isInteger(length)||length<8||length>1024)throw new Error("Length must be 8 to 1024 bytes.");const bytes=crypto.getRandomValues(new Uint8Array(length));result=root.querySelector<HTMLSelectElement>("[data-format]")?.value==="base64url"?base64Url(bytes):hex(bytes);}else{const length=Number(root.querySelector<HTMLInputElement>("[data-length]")?.value??24);if(!Number.isInteger(length)||length<4||length>4096)throw new Error("Length must be 4 to 4096.");let chars="";if(root.querySelector<HTMLInputElement>("[data-lower]")?.checked)chars+="abcdefghijklmnopqrstuvwxyz";if(root.querySelector<HTMLInputElement>("[data-upper]")?.checked)chars+="ABCDEFGHIJKLMNOPQRSTUVWXYZ";if(root.querySelector<HTMLInputElement>("[data-number]")?.checked)chars+="0123456789";if(root.querySelector<HTMLInputElement>("[data-symbol]")?.checked)chars+="!@#$%^&*()-_=+[]{};:,.?";if(!chars)throw new Error("Select at least one character group.");result=Array.from({length},()=>chars[randomIndex(chars.length)]).join("");}setResult(result,"success");notify("Generated");}catch(error){notify(error instanceof Error?error.message:"Unable to generate.",true);}}));
    root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach(button=>button.addEventListener("click",async()=>{if(!output?.value)return notify("Nothing to copy",true);await navigator.clipboard.writeText(output.value);notify("Copied");}));root.querySelectorAll<HTMLButtonElement>("[data-clear]").forEach(button=>button.addEventListener("click",()=>{if(input)input.value="";if(secondary)secondary.value="";if(output)output.value="";setResult("");update();notify("Cleared");}));
  });}
  setup();document.addEventListener("astro:page-load",setup);
</script>
