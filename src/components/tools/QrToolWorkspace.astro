---
interface Props { mode: string; }
const { mode } = Astro.props;
type QrInputType = "text" | "url" | "password" | "email" | "tel" | "number" | "datetime-local" | "checkbox";
const configs: Record<string, { title: string; fields: Array<{name:string;label:string;type?:QrInputType;placeholder?:string;options?:string[]}> }> = {
  "qr-text-generator": { title: "Text", fields: [{name:"text",label:"Text",placeholder:"Enter text"}] },
  "qr-url-generator": { title: "Website URL", fields: [{name:"url",label:"URL",type:"url",placeholder:"https://example.com"}] },
  "qr-wifi-generator": { title: "WiFi network", fields: [{name:"ssid",label:"Network name"},{name:"password",label:"Password",type:"password"},{name:"security",label:"Security",options:["WPA","WEP","nopass"]},{name:"hidden",label:"Hidden network",type:"checkbox"}] },
  "qr-email-generator": { title: "Email", fields: [{name:"email",label:"Email address",type:"email"},{name:"subject",label:"Subject"},{name:"message",label:"Message"}] },
  "qr-phone-generator": { title: "Phone number", fields: [{name:"phone",label:"Phone number",type:"tel"}] },
  "qr-sms-generator": { title: "SMS", fields: [{name:"phone",label:"Phone number",type:"tel"},{name:"message",label:"Message"}] },
  "qr-whatsapp-generator": { title: "WhatsApp", fields: [{name:"phone",label:"Phone number with country code",type:"tel"},{name:"message",label:"Message"}] },
  "qr-vcard-generator": { title: "Contact", fields: [{name:"name",label:"Full name"},{name:"phone",label:"Phone",type:"tel"},{name:"email",label:"Email",type:"email"},{name:"organization",label:"Organization"}] },
  "qr-location-generator": { title: "Location", fields: [{name:"latitude",label:"Latitude",type:"number"},{name:"longitude",label:"Longitude",type:"number"}] },
  "qr-event-generator": { title: "Event", fields: [{name:"title",label:"Event title"},{name:"start",label:"Start",type:"datetime-local"},{name:"end",label:"End",type:"datetime-local"},{name:"location",label:"Location"}] },
};
const fallbackConfig = configs["qr-text-generator"];
if (!fallbackConfig) throw new Error("Missing default QR configuration.");
const config = configs[mode] ?? fallbackConfig;
---
<section class="rounded-2xl border border-white/10 bg-zinc-900/80 p-4 shadow-xl shadow-black/20 sm:p-5" data-qr-workspace data-mode={mode}>
  <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <div>
      <h2 class="text-base font-semibold text-white">{config.title}</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {config.fields.map((field) => (
          <label class:list={["grid gap-1.5", field.name === "message" && "sm:col-span-2"]}>
            <span class="text-xs font-medium text-zinc-400">{field.label}</span>
            {field.options ? (
              <>
                <select name={field.name} class="rounded-xl border border-white/10 bg-zinc-950 px-3 py-2.5 text-sm text-white">
                  {field.options.map((option) => (
                    <option value={option}>
                      {option === "WPA" ? "WPA / WPA2 / WPA3" : option === "nopass" ? "No password" : option}
                    </option>
                  ))}
                </select>
                {field.name === "security" && (
                  <span class="text-[11px] leading-4 text-zinc-500">
                    Most home networks use WPA / WPA2. Choose WEP only for older routers.
                  </span>
                )}
              </>
            ) : field.type === "checkbox" ? (
              <span class="flex h-10 items-center gap-2 rounded-xl border border-white/10 bg-zinc-950 px-3">
                <input name={field.name} type="checkbox" class="size-4 accent-brand-500" />
                <span class="text-sm text-zinc-300">This WiFi network is hidden</span>
              </span>
            ) : field.type === "password" ? (
              <span class="flex overflow-hidden rounded-xl border border-white/10 bg-zinc-950">
                <input
                  name={field.name}
                  type="password"
                  placeholder={field.placeholder}
                  class="min-w-0 flex-1 bg-transparent px-3 py-2.5 text-sm text-white outline-none placeholder:text-zinc-600"
                />
                <button
                  type="button"
                  data-toggle-password
                  class="border-l border-white/10 px-3 text-xs font-medium text-zinc-400 transition hover:bg-white/5 hover:text-white"
                  aria-label="Show WiFi password"
                >
                  Show
                </button>
              </span>
            ) : (
              <input name={field.name} type={field.type ?? "text"} placeholder={field.placeholder} class="rounded-xl border border-white/10 bg-zinc-950 px-3 py-2.5 text-sm text-white placeholder:text-zinc-600" />
            )}
          </label>
        ))}
      </div>
      <div class="mt-4 rounded-xl border border-white/10 bg-zinc-950/50 p-3">
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="grid gap-1.5">
            <span class="text-xs font-medium text-zinc-400">QR color</span>
            <span class="flex items-center gap-2">
              <input data-dark-color type="color" value="#000000" class="size-10 cursor-pointer rounded-lg border border-white/10 bg-transparent p-1" aria-label="QR color" />
              <input data-dark-hex type="text" value="#000000" maxlength="7" spellcheck="false" class="min-w-0 flex-1 rounded-lg border border-white/10 bg-zinc-950 px-3 py-2 text-sm uppercase text-white" aria-label="QR color hex value" />
            </span>
          </label>

          <label class="grid gap-1.5">
            <span class="text-xs font-medium text-zinc-400">Background color</span>
            <span class="flex items-center gap-2">
              <input data-light-color type="color" value="#ffffff" class="size-10 cursor-pointer rounded-lg border border-white/10 bg-transparent p-1" aria-label="QR background color" />
              <input data-light-hex type="text" value="#FFFFFF" maxlength="7" spellcheck="false" class="min-w-0 flex-1 rounded-lg border border-white/10 bg-zinc-950 px-3 py-2 text-sm uppercase text-white" aria-label="QR background color hex value" />
            </span>
          </label>
        </div>

        <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
          <p data-contrast class="text-xs text-emerald-400">Contrast: 21.00:1 · Excellent</p>
          <button type="button" data-reset-colors class="rounded-lg border border-white/10 px-3 py-1.5 text-xs font-medium text-zinc-300 transition hover:bg-white/5 hover:text-white">Reset colors</button>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" data-download disabled class="cursor-pointer rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Download PNG</button>
        <button type="button" data-clear class="cursor-pointer rounded-lg border border-white/10 px-4 py-2 text-sm font-medium text-zinc-200 hover:bg-white/5">Clear</button>
      </div>
      <p data-status class="mt-3 text-xs text-zinc-500">Enter content to generate a QR code.</p>
    </div>
    <div
      data-preview
      class="box-border grid aspect-square w-full max-w-64 min-w-0 self-start place-items-center overflow-hidden rounded-2xl border border-white/10 bg-transparent p-0 shadow-lg shadow-black/20"
    >
      <canvas
        data-canvas
        width="256"
        height="256"
        class="block size-full aspect-square rounded-xl"
        style="width: 100% !important; height: 100% !important; max-width: 100% !important; max-height: 100% !important;"
        aria-label="Generated QR code"
      ></canvas>
    </div>
  </div>
</section>
<script>
  import QRCode from "qrcode";
  const escapeWifi = (value: string) => value.replace(/([\\;,:"])/g, "\\$1");
  const compactDate = (value: string) => value ? value.replace(/[-:]/g, "").replace(".", "").slice(0,15) : "";
  document.querySelectorAll<HTMLElement>("[data-qr-workspace]").forEach((root) => {
    const mode = root.dataset.mode ?? "";
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]");
    const download = root.querySelector<HTMLButtonElement>("[data-download]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const preview = root.querySelector<HTMLElement>("[data-preview]");
    const contrast = root.querySelector<HTMLElement>("[data-contrast]");
    const darkColor = root.querySelector<HTMLInputElement>("[data-dark-color]");
    const darkHex = root.querySelector<HTMLInputElement>("[data-dark-hex]");
    const lightColor = root.querySelector<HTMLInputElement>("[data-light-color]");
    const lightHex = root.querySelector<HTMLInputElement>("[data-light-hex]");
    const get = (name:string) => (root.querySelector<HTMLInputElement|HTMLSelectElement>(`[name="${name}"]`)?.value ?? "").trim();

    const normalizeHex = (value: string, fallback: string) => {
      const candidate = value.trim().toUpperCase();
      return /^#[0-9A-F]{6}$/.test(candidate) ? candidate : fallback;
    };

    const channel = (value: number) => {
      const normalized = value / 255;
      return normalized <= 0.03928
        ? normalized / 12.92
        : Math.pow((normalized + 0.055) / 1.055, 2.4);
    };

    const luminance = (hex: string) => {
      const color = normalizeHex(hex, "#000000");
      return (
        0.2126 * channel(parseInt(color.slice(1, 3), 16)) +
        0.7152 * channel(parseInt(color.slice(3, 5), 16)) +
        0.0722 * channel(parseInt(color.slice(5, 7), 16))
      );
    };

    const contrastRatio = (foreground: string, background: string) => {
      const first = luminance(foreground);
      const second = luminance(background);
      const lighter = Math.max(first, second);
      const darker = Math.min(first, second);
      return (lighter + 0.05) / (darker + 0.05);
    };

    const selectedColors = () => ({
      dark: normalizeHex(darkHex?.value ?? darkColor?.value ?? "#000000", "#000000"),
      light: normalizeHex(lightHex?.value ?? lightColor?.value ?? "#FFFFFF", "#FFFFFF"),
    });

    const updateColorUi = () => {
      const colors = selectedColors();
      if (darkColor) darkColor.value = colors.dark.toLowerCase();
      if (darkHex) darkHex.value = colors.dark;
      if (lightColor) lightColor.value = colors.light.toLowerCase();
      if (lightHex) lightHex.value = colors.light;
      if (preview) preview.style.backgroundColor = colors.light;

      const ratio = contrastRatio(colors.dark, colors.light);
      const safe = ratio >= 4.5;
      if (contrast) {
        contrast.textContent = safe
          ? `Contrast: ${ratio.toFixed(2)}:1 · Good for scanning`
          : `Contrast: ${ratio.toFixed(2)}:1 · Too low`;
        contrast.className = safe
          ? "text-xs text-emerald-400"
          : "text-xs font-medium text-amber-400";
      }
      return { ...colors, ratio, safe };
    };

    const payload = () => {
      if (mode === "qr-url-generator") return get("url");
      if (mode === "qr-wifi-generator") {
        const ssid = get("ssid");
        const security = get("security") || "WPA";
        const password = get("password");
        const hidden = root.querySelector<HTMLInputElement>('[name="hidden"]')?.checked ?? false;
        if (!ssid) return "";
        if (security !== "nopass" && !password) return "";
        const passwordPart = security === "nopass" ? "" : `P:${escapeWifi(password)};`;
        return `WIFI:S:${escapeWifi(ssid)};T:${security};${passwordPart}H:${hidden ? "true" : "false"};;`;
      }
      if (mode === "qr-email-generator") return get("email") ? `mailto:${get("email")}?subject=${encodeURIComponent(get("subject"))}&body=${encodeURIComponent(get("message"))}` : "";
      if (mode === "qr-phone-generator") return get("phone") ? `tel:${get("phone")}` : "";
      if (mode === "qr-sms-generator") return get("phone") ? `SMSTO:${get("phone")}:${get("message")}` : "";
      if (mode === "qr-whatsapp-generator") return get("phone") ? `https://wa.me/${get("phone").replace(/\D/g,"")}?text=${encodeURIComponent(get("message"))}` : "";
      if (mode === "qr-vcard-generator") return get("name") ? `BEGIN:VCARD\nVERSION:3.0\nFN:${get("name")}\nTEL:${get("phone")}\nEMAIL:${get("email")}\nORG:${get("organization")}\nEND:VCARD` : "";
      if (mode === "qr-location-generator") return get("latitude") && get("longitude") ? `geo:${get("latitude")},${get("longitude")}` : "";
      if (mode === "qr-event-generator") return get("title") ? `BEGIN:VEVENT\nSUMMARY:${get("title")}\nDTSTART:${compactDate(get("start"))}\nDTEND:${compactDate(get("end"))}\nLOCATION:${get("location")}\nEND:VEVENT` : "";
      return get("text");
    };
    const render = async () => {
      if (!canvas || !download || !status) return;
      const value = payload();
      const colors = updateColorUi();
      if (!value) {
        const context = canvas.getContext("2d");
        context?.clearRect(0, 0, canvas.width, canvas.height);
        download.disabled = true;
        if (
          mode === "qr-wifi-generator" &&
          get("ssid") &&
          get("security") !== "nopass" &&
          !get("password")
        ) {
          status.textContent = "Enter the WiFi password, or choose No password for an open network.";
        } else {
          status.textContent = "Enter content to generate a QR code.";
        }
        return;
      }
      try {
        await QRCode.toCanvas(canvas, value, {
          width: 256,
          margin: 4,
          errorCorrectionLevel: "H",
          color: {
            dark: colors.dark,
            light: colors.light,
          },
        });
        download.disabled = !colors.safe;
        status.textContent = colors.safe
          ? "QR code ready and optimized for scanning. Processing stays in your browser."
          : "Preview generated, but stronger color contrast is required before download.";
      } catch (error) {
        const context = canvas.getContext("2d");
        context?.clearRect(0, 0, canvas.width, canvas.height);
        download.disabled = true;
        status.textContent = "Unable to generate this QR code. Check the entered data and try again.";
        console.error("QR generation failed:", error);
      }
    };
    const syncColorPair = (
      picker: HTMLInputElement | null,
      hex: HTMLInputElement | null,
      source: "picker" | "hex",
    ) => {
      if (!picker || !hex) return;
      if (source === "picker") hex.value = picker.value.toUpperCase();
      else if (/^#[0-9A-Fa-f]{6}$/.test(hex.value.trim())) picker.value = hex.value.trim();
      render();
    };

    root.querySelector<HTMLButtonElement>("[data-toggle-password]")?.addEventListener("click", (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const passwordInput = root.querySelector<HTMLInputElement>('input[name="password"]');
      if (!passwordInput) return;
      const showing = passwordInput.type === "text";
      passwordInput.type = showing ? "password" : "text";
      button.textContent = showing ? "Show" : "Hide";
      button.setAttribute("aria-label", showing ? "Show WiFi password" : "Hide WiFi password");
    });

    darkColor?.addEventListener("input", () => syncColorPair(darkColor, darkHex, "picker"));
    darkHex?.addEventListener("input", () => syncColorPair(darkColor, darkHex, "hex"));
    lightColor?.addEventListener("input", () => syncColorPair(lightColor, lightHex, "picker"));
    lightHex?.addEventListener("input", () => syncColorPair(lightColor, lightHex, "hex"));

    root.querySelector("[data-reset-colors]")?.addEventListener("click", () => {
      if (darkColor) darkColor.value = "#000000";
      if (darkHex) darkHex.value = "#000000";
      if (lightColor) lightColor.value = "#ffffff";
      if (lightHex) lightHex.value = "#FFFFFF";
      render();
    });

    root.addEventListener("input", (event) => {
      const target = event.target;
      if (target === darkColor || target === darkHex || target === lightColor || target === lightHex) return;
      render();
    });
    root.addEventListener("change", render);
    root.querySelector("[data-clear]")?.addEventListener("click", () => {
      root.querySelectorAll<HTMLInputElement>(
        'input:not([type="color"]):not([data-dark-hex]):not([data-light-hex])',
      ).forEach((input) => {
        input.value = "";
      });
      render();
    });
    download?.addEventListener("click", async () => {
      if (!canvas) return;
      const value = payload();
      const colors = updateColorUi();
      if (!value || !colors.safe) return;

      const exportCanvas = document.createElement("canvas");
      try {
        await QRCode.toCanvas(exportCanvas, value, {
          width: 1024,
          margin: 4,
          errorCorrectionLevel: "H",
          color: {
            dark: colors.dark,
            light: colors.light,
          },
        });
        const link = document.createElement("a");
        link.download = "toolsiva-qr-code.png";
        link.href = exportCanvas.toDataURL("image/png");
        link.click();
      } catch (error) {
        if (status) status.textContent = "Unable to download this QR code.";
        console.error("QR download failed:", error);
      }
    });

    updateColorUi();
  });
</script>
