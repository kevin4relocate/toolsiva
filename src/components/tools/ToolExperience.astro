---
import { tools } from "@/data/tools";
import { categoryMap } from "@/data/categories";
import { getToolPath } from "@/types/tool";

const toolIndex = tools.map((tool) => ({
  name: tool.name,
  slug: tool.slug,
  category: tool.category,
  categoryName: categoryMap.get(tool.category)?.name ?? tool.category,
  description: tool.shortDescription,
  path: getToolPath(tool),
}));
---

<div
  id="toolsiva-command-palette"
  class="fixed inset-0 z-[150] hidden items-start justify-center bg-black/70 px-4 pt-[8vh] backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="toolsiva-command-title"
>
  <div class="w-full max-w-2xl overflow-hidden rounded-3xl border border-white/10 bg-zinc-950 shadow-2xl shadow-black/60">
    <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3">
      <input
        id="toolsiva-command-input"
        class="min-w-0 flex-1 bg-transparent py-2 text-base text-white outline-none placeholder:text-zinc-600"
        type="search"
        autocomplete="off"
        placeholder="Search tools..."
        aria-label="Search Toolsiva tools"
      />
      <kbd class="hidden rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-xs text-zinc-500 sm:inline">Esc</kbd>
    </div>

    <div class="max-h-[65vh] overflow-y-auto p-2">
      <div id="toolsiva-command-sections"></div>
      <p id="toolsiva-command-empty" class="hidden px-4 py-10 text-center text-sm text-zinc-500">
        No matching tools found.
      </p>
    </div>
  </div>
</div>

<script is:inline type="application/json" id="toolsiva-tool-index" set:html={JSON.stringify(toolIndex)} />

<script is:inline>
  (() => {
    const FAVORITES_KEY = "toolsiva_favorite_tools";
    const RECENT_KEY = "toolsiva_recent_tools";
    const MAX_RECENT = 8;

    const palette = document.getElementById("toolsiva-command-palette");
    const input = document.getElementById("toolsiva-command-input");
    const sections = document.getElementById("toolsiva-command-sections");
    const empty = document.getElementById("toolsiva-command-empty");
    const indexNode = document.getElementById("toolsiva-tool-index");

    if (!palette || !input || !sections || !empty || !indexNode) return;

    let toolIndex = [];
    try {
      toolIndex = JSON.parse(indexNode.textContent || "[]");
    } catch {
      toolIndex = [];
    }

    let activeIndex = 0;

    const readArray = (key) => {
      try {
        const value = JSON.parse(localStorage.getItem(key) || "[]");
        return Array.isArray(value) ? value.filter((item) => typeof item === "string") : [];
      } catch {
        return [];
      }
    };

    const writeArray = (key, value) => {
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch {}
    };

    const favoritePaths = () => readArray(FAVORITES_KEY);
    const recentPaths = () => readArray(RECENT_KEY);

    const currentTool = toolIndex.find((tool) => tool.path === window.location.pathname);
    if (currentTool) {
      writeArray(
        RECENT_KEY,
        [currentTool.path, ...recentPaths().filter((path) => path !== currentTool.path)].slice(0, MAX_RECENT),
      );
    }

    const escapeHtml = (value) =>
      String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");

    const score = (tool, query) => {
      const name = tool.name.toLowerCase();
      const slug = tool.slug.toLowerCase();
      const category = tool.categoryName.toLowerCase();
      const description = tool.description.toLowerCase();
      if (name === query) return 100;
      if (name.startsWith(query)) return 80;
      if (slug.startsWith(query)) return 70;
      if (name.includes(query)) return 60;
      if (slug.includes(query)) return 50;
      if (category.includes(query)) return 35;
      if (description.includes(query)) return 20;
      return 0;
    };

    const sectionHtml = (title, items) => {
      if (!items.length) return "";
      return `
        <section class="mb-3 last:mb-0">
          <h2 class="px-3 pb-2 pt-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-600">${escapeHtml(title)}</h2>
          <div class="grid gap-1">
            ${items.map((tool) => `
              <a href="${escapeHtml(tool.path)}" data-command-result
                class="group rounded-xl px-3 py-3 transition hover:bg-white/5 focus:bg-white/5 focus:outline-none">
                <strong class="block truncate text-sm text-zinc-100">${escapeHtml(tool.name)}</strong>
                <span class="mt-1 block truncate text-xs text-zinc-500">${escapeHtml(tool.description)}</span>
              </a>
            `).join("")}
          </div>
        </section>
      `;
    };

    const setActive = (nextIndex) => {
      const links = Array.from(sections.querySelectorAll("[data-command-result]"));
      if (!links.length) return;
      activeIndex = (nextIndex + links.length) % links.length;
      links.forEach((link, index) => link.classList.toggle("bg-white/5", index === activeIndex));
      links[activeIndex]?.scrollIntoView({ block: "nearest" });
    };

    const render = () => {
      const query = input.value.trim().toLowerCase();
      let shown = [];

      if (query) {
        shown = toolIndex
          .map((tool) => ({ tool, value: score(tool, query) }))
          .filter((entry) => entry.value > 0)
          .sort((a, b) => b.value - a.value || a.tool.name.localeCompare(b.tool.name))
          .slice(0, 30)
          .map((entry) => entry.tool);
        sections.innerHTML = sectionHtml("Search results", shown);
      } else {
        const favorites = favoritePaths()
          .map((path) => toolIndex.find((tool) => tool.path === path))
          .filter(Boolean);
        const recent = recentPaths()
          .map((path) => toolIndex.find((tool) => tool.path === path))
          .filter(Boolean)
          .filter((tool) => !favoritePaths().includes(tool.path));
        const explore = toolIndex
          .filter((tool) => !favoritePaths().includes(tool.path) && !recentPaths().includes(tool.path))
          .slice(0, 8);

        shown = [...favorites, ...recent, ...explore];
        sections.innerHTML =
          sectionHtml("Favorites", favorites) +
          sectionHtml("Recently used", recent) +
          sectionHtml("Explore tools", explore);
      }

      empty.classList.toggle("hidden", shown.length > 0);
      setActive(0);
    };

    const openPalette = () => {
      palette.classList.remove("hidden");
      palette.classList.add("flex");
      document.documentElement.classList.add("overflow-hidden");
      input.value = "";
      render();
      setTimeout(() => input.focus(), 0);
    };

    const closePalette = () => {
      palette.classList.add("hidden");
      palette.classList.remove("flex");
      document.documentElement.classList.remove("overflow-hidden");
    };

    document.querySelectorAll("[data-open-command-palette]").forEach((button) => {
      button.addEventListener("click", openPalette);
    });

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        openPalette();
        return;
      }

      if (palette.classList.contains("hidden")) return;

      if (event.key === "Escape") closePalette();
      else if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(activeIndex - 1);
      }
    });

    input.addEventListener("input", render);
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === "Enter") {
        event.preventDefault();
        sections.querySelectorAll("[data-command-result]")[activeIndex]?.click();
      } else if (event.key === "Escape") {
        closePalette();
      }
    });

    palette.addEventListener("pointerdown", (event) => {
      if (event.target === palette) closePalette();
    });

    if (currentTool) {
      const header = document.querySelector("main h1")?.closest("header");
      if (header) {
        const button = document.createElement("button");
        button.type = "button";
        button.className =
          "focus-ring mt-3 inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-sm font-semibold text-zinc-300 transition hover:border-brand-400/40 hover:bg-white/5 hover:text-white";

        const refresh = () => {
          const selected = favoritePaths().includes(currentTool.path);
          button.setAttribute("aria-pressed", selected ? "true" : "false");
          button.innerHTML = selected ? "★ Saved to favorites" : "☆ Add to favorites";
        };

        button.addEventListener("click", () => {
          const favorites = favoritePaths();
          const next = favorites.includes(currentTool.path)
            ? favorites.filter((path) => path !== currentTool.path)
            : [currentTool.path, ...favorites.filter((path) => path !== currentTool.path)];
          writeArray(FAVORITES_KEY, next);
          refresh();
        });

        refresh();
        header.appendChild(button);
      }
    }
  })();
</script>
