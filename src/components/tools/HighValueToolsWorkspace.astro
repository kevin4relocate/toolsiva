---
interface Props {
  mode: string;
}

const { mode } = Astro.props;
---

<section
  class="rounded-2xl border border-white/10 bg-white/[0.02] p-4 sm:p-5"
  data-high-value-tool
  data-mode={mode}
>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <p data-help class="text-sm text-zinc-400">Enter values to begin.</p>
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-copy
        class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-brand-400/40 hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Copy result
      </button>
      <button
        type="button"
        data-clear
        class="focus-ring cursor-pointer rounded-xl border border-white/10 px-4 py-2 text-sm font-medium hover:border-red-400/40 hover:bg-red-500/10 hover:text-red-200"
      >
        Clear
      </button>
    </div>
  </div>

  <div data-workspace></div>
</section>

<script is:inline src="/highValueTools.js"></script>
