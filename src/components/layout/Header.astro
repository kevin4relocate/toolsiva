---
import { categories } from "@/data/categories";
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-zinc-950/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="focus-ring flex items-center gap-2 rounded-lg" aria-label="Toolsiva home">
      <span class="grid size-9 place-items-center rounded-xl bg-brand-600 font-black text-white">T</span>
      <span class="text-lg font-bold tracking-tight">Toolsiva</span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-6 text-sm text-zinc-300 md:flex">
      <a class="transition hover:text-white" href="/tools">All Tools</a>
      {categories.slice(0, 4).map((category) => (
        <a class="transition hover:text-white" href={`/tools/${category.slug}`}>
          {category.name}
        </a>
      ))}
    </nav>

    <a
      href="/tools"
      class="focus-ring rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm font-medium transition hover:bg-white/10"
    >
      Browse tools
    </a>
  </div>
</header>
