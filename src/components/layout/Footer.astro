---
import { categories } from "@/data/categories";
import { siteConfig } from "@/config/site";

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-white/10 bg-zinc-950/60">
  <div class="mx-auto max-w-[84rem] px-4 py-10 sm:px-5 lg:px-6">
    <div class="grid gap-10 md:grid-cols-[1.25fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="focus-ring inline-flex items-center gap-2 rounded-lg">
          <span class="grid size-9 place-items-center rounded-xl bg-brand-600 font-black text-white">T</span>
          <span class="text-lg font-bold tracking-tight text-white">Toolsiva</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-6 text-zinc-400">
          Fast, focused and privacy-friendly online tools. Most processing happens directly in
          your browser, without requiring an account.
        </p>
        <p class="mt-4 text-xs leading-5 text-zinc-500">
          Toolsiva provides general-purpose utilities. Results should be reviewed before use in
          financial, medical, legal or other high-stakes decisions.
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-white">Tools</h2>
        <nav class="mt-4 grid gap-2 text-sm text-zinc-400" aria-label="Footer tool categories">
          {categories.slice(0, 6).map((category) => (
            <a class="w-fit transition hover:text-white" href={`/tools/${category.slug}`}>
              {category.name}
            </a>
          ))}
        </nav>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-white">Company</h2>
        <nav class="mt-4 grid gap-2 text-sm text-zinc-400" aria-label="Footer company navigation">
          <a class="w-fit transition hover:text-white" href="/about">About</a>
          <a class="w-fit transition hover:text-white" href="/contact">Contact</a>
          <a class="w-fit transition hover:text-white" href="/accessibility">Accessibility</a>
          <a class="w-fit transition hover:text-white" href="/tools">All tools</a>
        </nav>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-white">Legal</h2>
        <nav class="mt-4 grid gap-2 text-sm text-zinc-400" aria-label="Footer legal navigation">
          <a class="w-fit transition hover:text-white" href="/privacy">Privacy Policy</a>
          <button
            type="button"
            data-open-cookie-settings
            class="w-fit text-left transition hover:text-white"
          >
            Cookie settings
          </button>
          <a class="w-fit transition hover:text-white" href="/terms">Terms of Use</a>
          <a class="w-fit transition hover:text-white" href="/disclaimer">Disclaimer</a>
        </nav>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {siteConfig.foundedYear === currentYear ? currentYear : `${siteConfig.foundedYear}–${currentYear}`} Toolsiva.
        All rights reserved.
      </p>
      <p>Fast tools. Private by default.</p>
    </div>
  </div>
</footer>
