---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold text-brand-300">404</p>
    <h1 class="mt-3 text-5xl font-black text-white">Page not found</h1>
    <p class="mt-5 text-zinc-400">The page may have moved or does not exist.</p>
    <a class="mt-8 inline-block rounded-xl bg-brand-600 px-5 py-3 font-semibold" href="/">Return home</a>
  </section>
</BaseLayout>
