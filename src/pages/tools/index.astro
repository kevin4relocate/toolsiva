---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolCard from "@/components/common/ToolCard.astro";
import { categories } from "@/data/categories";
import { tools } from "@/data/tools";
---

<BaseLayout
  title="All Online Tools"
  description="Browse fast, private and easy-to-use online tools from Toolsiva."
>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-black text-white sm:text-5xl">All tools</h1>
    <p class="mt-4 max-w-2xl text-lg text-zinc-400">
      Browse tools by category. Interactive processing stays in your browser whenever possible.
    </p>

    <div class="mt-12 space-y-14">
      {categories.map((category) => {
        const categoryTools = tools.filter((tool) => tool.category === category.slug);
        return (
          <section>
            <div class="mb-6 flex items-end justify-between gap-4">
              <div>
                <h2 class="text-2xl font-bold text-white">{category.name}</h2>
                <p class="mt-2 text-zinc-400">{category.description}</p>
              </div>
              <a class="text-sm font-semibold text-brand-300 hover:text-brand-200" href={`/tools/${category.slug}`}>
                View category
              </a>
            </div>
            {categoryTools.length > 0 ? (
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {categoryTools.map((tool) => <ToolCard tool={tool} />)}
              </div>
            ) : (
              <p class="rounded-2xl border border-dashed border-white/10 p-6 text-sm text-zinc-500">
                Tools in this category are coming in a future package.
              </p>
            )}
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>
