---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site";
import AdSlot from "@/components/common/AdSlot.astro";
import TextToolWorkspace from "@/components/tools/TextToolWorkspace.astro";
import DeveloperToolWorkspace from "@/components/tools/DeveloperToolWorkspace.astro";
import SecurityToolWorkspace from "@/components/tools/SecurityToolWorkspace.astro";
import QrToolWorkspace from "@/components/tools/QrToolWorkspace.astro";
import CalculatorToolWorkspace from "@/components/tools/CalculatorToolWorkspace.astro";
import ConverterToolWorkspace from "@/components/tools/ConverterToolWorkspace.astro";
import ExpansionToolWorkspace from "@/components/tools/ExpansionToolWorkspace.astro";
import NewTextToolsWorkspace from "@/components/tools/NewTextToolsWorkspace.astro";
import HighValueToolsWorkspace from "@/components/tools/HighValueToolsWorkspace.astro";
import ContentGenerationWorkspace from "@/components/tools/ContentGenerationWorkspace.astro";
import MarkdownLivePreviewWorkspace from "@/components/tools/MarkdownLivePreviewWorkspace.astro";
import SimpleToolWorkspace from "@/components/tools/SimpleToolWorkspace.astro";
import simpleToolQueue from "@/data/simpleToolQueue.json";
import { tools, getRelatedTools } from "@/data/tools";
import { categoryMap } from "@/data/categories";
import { getToolPath } from "@/types/tool";
import { getToolInstructions } from "@/data/toolInstructions";
import ToolSeoContent from "@/components/tools/ToolSeoContent.astro";
import highIntentToolExamples from "@/data/highIntentToolExamples.json";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: {
      category: tool.category,
      slug: tool.slug,
    },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const simpleTool = simpleToolQueue.find((entry) => entry.slug === tool.slug);
const isQueuedSimpleTool = Boolean(simpleTool);
const category = categoryMap.get(tool.category);
const relatedTools = getRelatedTools(tool);
const instructions = getToolInstructions(tool);
const highlightedExample = highIntentToolExamples[tool.slug as keyof typeof highIntentToolExamples];
const linkedGuides = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .filter((post) =>
    post.data.primaryToolPath.replace(/\/+$/, "") === getToolPath(tool).replace(/\/+$/, "") ||
    post.data.relatedTools.some((related) => related.path.replace(/\/+$/, "") === getToolPath(tool).replace(/\/+$/, ""))
  )
  .sort((a, b) => b.data.updatedDate.getTime() - a.data.updatedDate.getTime())
  .slice(0, 3);
const expansionToolSlugs = new Set(["line-counter","sentence-counter","paragraph-counter","text-to-list","list-to-text","remove-empty-lines","add-line-numbers","strip-html-tags","text-repeater","whitespace-visualizer","ratio-calculator","proportion-calculator","fraction-calculator","gcd-lcm-calculator","pace-calculator","unit-price-calculator","profit-margin-calculator","markup-calculator"]);
const newTextToolSlugs = new Set(["add-bullets-to-text", "add-blank-lines-between-text", "add-prefix-suffix-to-lines", "trim-each-line", "quote-each-line", "remove-line-numbers", "extract-emails-from-text", "extract-urls-from-text"]);
const highValueToolSlugs = new Set(["regex-tester", "utm-url-generator", "markdown-table-generator", "word-frequency-counter", "programming-case-converter", "morse-code-translator", "binary-code-translator", "number-sorter", "remove-line-breaks", "random-choice-generator"]);
const contentGenerationToolSlugs = new Set(["random-text-generator", "markdown-to-html", "html-to-markdown", "markdown-to-plain-text"]);
const markdownLivePreviewSlugs = new Set(["markdown-live-preview"]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const toolUrl = new URL(getToolPath(tool), siteConfig.url).toString();
const categoryUrl = new URL(`/tools/${tool.category}/`, siteConfig.url).toString();

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.name,
  url: toolUrl,
  description: tool.metaDescription,
  applicationCategory: "UtilitiesApplication",
  applicationSubCategory: category?.name ?? "Online Tool",
  operatingSystem: "Any",
  browserRequirements: "Requires a modern web browser with JavaScript enabled.",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  publisher: {
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
  },
  featureList: [
    tool.shortDescription,
    "Runs directly in a modern web browser",
    "No account required",
  ],
  inLanguage: siteConfig.language,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Tools",
      item: new URL("/tools/", siteConfig.url).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: category?.name ?? "Tools",
      item: categoryUrl,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: tool.name,
      item: toolUrl,
    },
  ],
};
import { safeJsonForHtml } from "@/lib/safeJsonForHtml";
---

<BaseLayout
  title={highlightedExample?.seoTitle ?? tool.name}
  description={tool.metaDescription}
  canonicalPath={getToolPath(tool)}
>
  <script is:inline type="application/ld+json" set:html={safeJsonForHtml(webApplicationSchema)} />
  <script is:inline type="application/ld+json" set:html={safeJsonForHtml(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={safeJsonForHtml(faqSchema)} />

  <div class="mx-auto grid w-full max-w-[84rem] grid-cols-1 px-4 py-5 sm:px-5 lg:px-6 lg:py-6 min-[1800px]:max-w-[107.5rem] min-[1800px]:grid-cols-[160px_minmax(0,84rem)_160px] min-[1800px]:gap-6">
    <div class="hidden min-[1800px]:block"><AdSlot placement="tool-side-left" minHeight={600} variant="side-rail" /></div>
    <article class="min-w-0 w-full">
    <nav class="mb-3 text-xs text-zinc-500 sm:text-sm" aria-label="Breadcrumb">
      <a class="hover:text-white" href="/tools/">Tools</a>
      <span class="mx-2">/</span>
      <a class="hover:text-white" href={`/tools/${tool.category}/`}>{category?.name}</a>
      <span class="mx-2">/</span>
      <span>{tool.name}</span>
    </nav>

    <header class="mb-4">
      <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-300">
        Free online tool
      </p>
      <h1 class="text-2xl font-black tracking-tight text-white sm:text-3xl lg:text-[2.35rem]">{tool.name}</h1>
      <p class="mt-2.5 max-w-3xl text-sm leading-6 text-zinc-400 sm:text-base">{tool.shortDescription}</p>
    </header>

    <AdSlot placement="tool-top" minHeight={0} />

    {isQueuedSimpleTool && simpleTool && <SimpleToolWorkspace mode={tool.slug} example={simpleTool.example} />}
    {newTextToolSlugs.has(tool.slug) && <NewTextToolsWorkspace mode={tool.slug} />}
    {contentGenerationToolSlugs.has(tool.slug) && <ContentGenerationWorkspace mode={tool.slug} />}
    {markdownLivePreviewSlugs.has(tool.slug) && <MarkdownLivePreviewWorkspace />}
    {highValueToolSlugs.has(tool.slug) && <HighValueToolsWorkspace mode={tool.slug} />}
    {expansionToolSlugs.has(tool.slug) && <ExpansionToolWorkspace mode={tool.slug} />}
    {!contentGenerationToolSlugs.has(tool.slug) && !highValueToolSlugs.has(tool.slug) && !newTextToolSlugs.has(tool.slug) && !expansionToolSlugs.has(tool.slug) && !isQueuedSimpleTool && tool.category === "text" && <TextToolWorkspace mode={tool.slug} />}
    {!markdownLivePreviewSlugs.has(tool.slug) && !contentGenerationToolSlugs.has(tool.slug) && !highValueToolSlugs.has(tool.slug) && !isQueuedSimpleTool && tool.category === "developer" && <DeveloperToolWorkspace mode={tool.slug} />}
    {!highValueToolSlugs.has(tool.slug) && !isQueuedSimpleTool && tool.category === "security" && <SecurityToolWorkspace mode={tool.slug} />}
    {tool.category === "qr" && <QrToolWorkspace mode={tool.slug} />}
    {!expansionToolSlugs.has(tool.slug) && !isQueuedSimpleTool && tool.category === "calculator" && <CalculatorToolWorkspace mode={tool.slug} />}
    {!isQueuedSimpleTool && tool.category === "converter" && <ConverterToolWorkspace mode={tool.slug} />}

    <section class="mt-10">
      <h2 class="text-xl font-bold text-white">How to use this tool</h2>
      <ol class="mt-3 grid gap-3 text-sm text-zinc-300 sm:grid-cols-3">
        {instructions.map((item, index) => (
          <li class="rounded-xl border border-white/10 p-4">
            <strong class="block text-white">{index + 1}. {item.title}</strong>
            <span class="mt-1.5 block text-xs leading-5 text-zinc-400">{item.description}</span>
          </li>
        ))}
      </ol>
    </section>

    {highlightedExample && (
      <section class="mt-10 rounded-2xl border border-brand-400/20 bg-brand-500/[0.045] p-5 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-300">Worked example</p>
        <h2 class="mt-2 text-xl font-bold text-white">{highlightedExample.title}</h2>
        <p class="mt-3 max-w-3xl text-sm leading-7 text-zinc-300">{highlightedExample.introduction}</p>
        <dl class="mt-5 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-white/10 p-4">
            <dt class="text-xs font-bold uppercase tracking-wider text-zinc-400">Example input</dt>
            <dd class="mt-2 text-sm leading-6 text-white">{highlightedExample.input}</dd>
          </div>
          <div class="rounded-xl border border-white/10 p-4">
            <dt class="text-xs font-bold uppercase tracking-wider text-zinc-400">Expected result</dt>
            <dd class="mt-2 text-sm leading-6 text-white">{highlightedExample.output}</dd>
          </div>
        </dl>
        <p class="mt-4 text-sm leading-6 text-zinc-400">
          <strong class="text-zinc-200">Before reusing the answer:</strong> {highlightedExample.limitation}
        </p>
      </section>
    )}

    <section class="mt-16">
      <h2 class="text-xl font-bold text-white">Frequently asked questions</h2>
      <div class="mt-3 divide-y divide-white/10 rounded-xl border border-white/10 px-4">
        {
          tool.faq.map((item) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-semibold text-white">{item.question}</summary>
              <p class="mt-2.5 max-w-3xl text-sm leading-6 text-zinc-400">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <ToolSeoContent tool={tool} />

    {linkedGuides.length > 0 && (
      <section class="mt-12 rounded-2xl border border-white/10 p-5 sm:p-6">
        <h2 class="text-xl font-bold text-white">Practical guides using this tool</h2>
        <p class="mt-2 text-sm text-zinc-400">Follow a related tutorial with examples and step-by-step context.</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {linkedGuides.map((post) => (
            <li>
              <a href={`/blog/${post.data.slug}/`} class="block rounded-xl border border-white/10 p-4 transition hover:border-brand-400/40 hover:text-brand-200">
                <strong class="text-sm text-white">{post.data.title}</strong>
                <span class="mt-1 block text-xs leading-5 text-zinc-400">{post.data.excerpt}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}



    {
      relatedTools.length > 0 && (
        <section class="mt-12 rounded-3xl border border-brand-400/20 bg-brand-500/[0.05] p-5 sm:p-7">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-300">Continue working</p>
              <h2 class="mt-2 text-xl font-bold text-white">Related tools</h2>
            </div>
            <a class="text-sm font-semibold text-brand-300 hover:text-brand-200" href={`/tools/${tool.category}/`}>View all {category?.name} →</a>
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedTools.map((related) => (
              <a
                class="group rounded-2xl border border-white/10 bg-zinc-950/50 p-4 transition hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-zinc-950/80"
                href={getToolPath(related)}
              >
                <strong class="text-white group-hover:text-brand-200">{related.name}</strong>
                <span class="mt-1.5 block text-xs leading-5 text-zinc-400">{related.shortDescription}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
    </article>
    <div class="hidden min-[1800px]:block"><AdSlot placement="tool-side-right" minHeight={600} variant="side-rail" /></div>
  </div>
</BaseLayout>
