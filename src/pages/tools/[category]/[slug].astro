---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdSlot from "@/components/common/AdSlot.astro";
import TextToolWorkspace from "@/components/tools/TextToolWorkspace.astro";
import DeveloperToolWorkspace from "@/components/tools/DeveloperToolWorkspace.astro";
import SecurityToolWorkspace from "@/components/tools/SecurityToolWorkspace.astro";
import QrToolWorkspace from "@/components/tools/QrToolWorkspace.astro";
import CalculatorToolWorkspace from "@/components/tools/CalculatorToolWorkspace.astro";
import ConverterToolWorkspace from "@/components/tools/ConverterToolWorkspace.astro";
import ExpansionToolWorkspace from "@/components/tools/ExpansionToolWorkspace.astro";
import NewTextToolsWorkspace from "@/components/tools/NewTextToolsWorkspace.astro";
import HighValueToolsWorkspace from "@/components/tools/HighValueToolsWorkspace.astro";
import { tools, getRelatedTools } from "@/data/tools";
import { categoryMap } from "@/data/categories";
import { getToolPath } from "@/types/tool";
import { getToolInstructions } from "@/data/toolInstructions";
import ToolSeoContent from "@/components/tools/ToolSeoContent.astro";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: {
      category: tool.category,
      slug: tool.slug,
    },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const category = categoryMap.get(tool.category);
const relatedTools = getRelatedTools(tool);
const instructions = getToolInstructions(tool);
const expansionToolSlugs = new Set(["line-counter","sentence-counter","paragraph-counter","text-to-list","list-to-text","remove-empty-lines","add-line-numbers","strip-html-tags","text-repeater","whitespace-visualizer","ratio-calculator","proportion-calculator","fraction-calculator","gcd-lcm-calculator","pace-calculator","unit-price-calculator","profit-margin-calculator","markup-calculator"]);
const newTextToolSlugs = new Set(["add-bullets-to-text", "add-blank-lines-between-text", "add-prefix-suffix-to-lines", "trim-each-line", "quote-each-line", "remove-line-numbers", "extract-emails-from-text", "extract-urls-from-text"]);
const highValueToolSlugs = new Set(["regex-tester", "utm-url-generator", "markdown-table-generator", "word-frequency-counter", "programming-case-converter", "morse-code-translator", "binary-code-translator", "number-sorter", "remove-line-breaks", "random-choice-generator"]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Tools",
      item: "https://toolsiva.com/tools",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: category?.name,
      item: `https://toolsiva.com/tools/${tool.category}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: tool.name,
      item: `https://toolsiva.com${getToolPath(tool)}`,
    },
  ],
};
---

<BaseLayout
  title={tool.name}
  description={tool.metaDescription}
  canonicalPath={getToolPath(tool)}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="mx-auto grid w-full grid-cols-1 px-4 py-5 sm:px-5 lg:px-6 lg:py-6 min-[1700px]:max-w-[1608px] min-[1700px]:grid-cols-[160px_minmax(0,1240px)_160px] min-[1700px]:gap-6">
    <div class="hidden min-[1700px]:block"><AdSlot placement="tool-side-left" minHeight={600} variant="side-rail" /></div>
    <article class="min-w-0 w-full max-w-[84rem] justify-self-center min-[1700px]:max-w-[77.5rem]">
    <nav class="mb-3 text-xs text-zinc-500 sm:text-sm" aria-label="Breadcrumb">
      <a class="hover:text-white" href="/tools">Tools</a>
      <span class="mx-2">/</span>
      <a class="hover:text-white" href={`/tools/${tool.category}`}>{category?.name}</a>
      <span class="mx-2">/</span>
      <span>{tool.name}</span>
    </nav>

    <header class="mb-4">
      <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-300">
        Free online tool
      </p>
      <h1 class="text-2xl font-black tracking-tight text-white sm:text-3xl lg:text-[2.35rem]">{tool.name}</h1>
      <p class="mt-2.5 max-w-3xl text-sm leading-6 text-zinc-400 sm:text-base">{tool.shortDescription}</p>
    </header>

    <AdSlot placement="tool-top" minHeight={0} />

    {newTextToolSlugs.has(tool.slug) && <NewTextToolsWorkspace mode={tool.slug} />}
    {highValueToolSlugs.has(tool.slug) && <HighValueToolsWorkspace mode={tool.slug} />}
    {expansionToolSlugs.has(tool.slug) && <ExpansionToolWorkspace mode={tool.slug} />}
    {!highValueToolSlugs.has(tool.slug) && !newTextToolSlugs.has(tool.slug) && !expansionToolSlugs.has(tool.slug) && tool.category === "text" && <TextToolWorkspace mode={tool.slug} />}
    {!highValueToolSlugs.has(tool.slug) && tool.category === "developer" && <DeveloperToolWorkspace mode={tool.slug} />}
    {!highValueToolSlugs.has(tool.slug) && tool.category === "security" && <SecurityToolWorkspace mode={tool.slug} />}
    {tool.category === "qr" && <QrToolWorkspace mode={tool.slug} />}
    {!expansionToolSlugs.has(tool.slug) && tool.category === "calculator" && <CalculatorToolWorkspace mode={tool.slug} />}
    {tool.category === "converter" && <ConverterToolWorkspace mode={tool.slug} />}

    <section class="mt-10">
      <h2 class="text-xl font-bold text-white">How to use this tool</h2>
      <ol class="mt-3 grid gap-3 text-sm text-zinc-300 sm:grid-cols-3">
        {instructions.map((item, index) => (
          <li class="rounded-xl border border-white/10 p-4">
            <strong class="block text-white">{index + 1}. {item.title}</strong>
            <span class="mt-1.5 block text-xs leading-5 text-zinc-400">{item.description}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-16">
      <h2 class="text-xl font-bold text-white">Frequently asked questions</h2>
      <div class="mt-3 divide-y divide-white/10 rounded-xl border border-white/10 px-4">
        {
          tool.faq.map((item) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-semibold text-white">{item.question}</summary>
              <p class="mt-2.5 max-w-3xl text-sm leading-6 text-zinc-400">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <ToolSeoContent tool={tool} />

    {
      relatedTools.length > 0 && (
        <section class="mt-12 rounded-3xl border border-brand-400/20 bg-brand-500/[0.05] p-5 sm:p-7">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-300">Continue working</p>
              <h2 class="mt-2 text-xl font-bold text-white">Related tools</h2>
            </div>
            <a class="text-sm font-semibold text-brand-300 hover:text-brand-200" href={`/tools/${tool.category}`}>View all {category?.name} →</a>
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedTools.map((related) => (
              <a
                class="group rounded-2xl border border-white/10 bg-zinc-950/50 p-4 transition hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-zinc-950/80"
                href={getToolPath(related)}
              >
                <strong class="text-white group-hover:text-brand-200">{related.name}</strong>
                <span class="mt-1.5 block text-xs leading-5 text-zinc-400">{related.shortDescription}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
    </article>
    <div class="hidden min-[1700px]:block"><AdSlot placement="tool-side-right" minHeight={600} variant="side-rail" /></div>
  </div>
</BaseLayout>
