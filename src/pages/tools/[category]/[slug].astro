---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdSlot from "@/components/common/AdSlot.astro";
import TextToolWorkspace from "@/components/tools/TextToolWorkspace.astro";
import DeveloperToolWorkspace from "@/components/tools/DeveloperToolWorkspace.astro";
import SecurityToolWorkspace from "@/components/tools/SecurityToolWorkspace.astro";
import { tools, getRelatedTools } from "@/data/tools";
import { categoryMap } from "@/data/categories";
import { getToolPath } from "@/types/tool";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: {
      category: tool.category,
      slug: tool.slug,
    },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const category = categoryMap.get(tool.category);
const relatedTools = getRelatedTools(tool);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Tools",
      item: "https://toolsiva.com/tools",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: category?.name,
      item: `https://toolsiva.com/tools/${tool.category}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: tool.name,
      item: `https://toolsiva.com${getToolPath(tool)}`,
    },
  ],
};
---

<BaseLayout
  title={tool.name}
  description={tool.metaDescription}
  canonicalPath={getToolPath(tool)}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="mx-auto w-full max-w-[92rem] px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <nav class="mb-4 text-sm text-zinc-500" aria-label="Breadcrumb">
      <a class="hover:text-white" href="/tools">Tools</a>
      <span class="mx-2">/</span>
      <a class="hover:text-white" href={`/tools/${tool.category}`}>{category?.name}</a>
      <span class="mx-2">/</span>
      <span>{tool.name}</span>
    </nav>

    <header class="mb-5">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-300">
        Free online tool
      </p>
      <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-[2.65rem]">{tool.name}</h1>
      <p class="mt-3 max-w-4xl text-base leading-7 text-zinc-400 sm:text-lg">{tool.shortDescription}</p>
    </header>

    <AdSlot placement="tool-top" minHeight={0} />

    {tool.category === "text" && <TextToolWorkspace mode={tool.slug} />}
    {tool.category === "developer" && <DeveloperToolWorkspace mode={tool.slug} />}
    {tool.category === "security" && <SecurityToolWorkspace mode={tool.slug} />}

    <section class="mt-16">
      <h2 class="text-2xl font-bold text-white">How to use this tool</h2>
      <ol class="mt-5 grid gap-4 text-zinc-300 sm:grid-cols-3">
        <li class="rounded-2xl border border-white/10 p-5">
          <strong class="block text-white">1. Add your text</strong>
          <span class="mt-2 block text-sm text-zinc-400">Type or paste content into the input area.</span>
        </li>
        <li class="rounded-2xl border border-white/10 p-5">
          <strong class="block text-white">2. Process it</strong>
          <span class="mt-2 block text-sm text-zinc-400">Choose an option when available and run the tool.</span>
        </li>
        <li class="rounded-2xl border border-white/10 p-5">
          <strong class="block text-white">3. Copy the result</strong>
          <span class="mt-2 block text-sm text-zinc-400">Review the output and copy it when finished.</span>
        </li>
      </ol>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-bold text-white">Frequently asked questions</h2>
      <div class="mt-5 divide-y divide-white/10 rounded-2xl border border-white/10 px-6">
        {
          tool.faq.map((item) => (
            <details class="group py-5">
              <summary class="cursor-pointer list-none font-semibold text-white">{item.question}</summary>
              <p class="mt-3 max-w-3xl leading-7 text-zinc-400">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    {
      relatedTools.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-bold text-white">Related tools</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedTools.map((related) => (
              <a
                class="rounded-2xl border border-white/10 p-5 transition hover:border-brand-400/40"
                href={getToolPath(related)}
              >
                <strong>{related.name}</strong>
                <span class="mt-2 block text-sm text-zinc-400">{related.shortDescription}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
