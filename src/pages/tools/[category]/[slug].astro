---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdSlot from "@/components/common/AdSlot.astro";
import TextToolWorkspace from "@/components/tools/TextToolWorkspace.astro";
import DeveloperToolWorkspace from "@/components/tools/DeveloperToolWorkspace.astro";
import SecurityToolWorkspace from "@/components/tools/SecurityToolWorkspace.astro";
import QrToolWorkspace from "@/components/tools/QrToolWorkspace.astro";
import CalculatorToolWorkspace from "@/components/tools/CalculatorToolWorkspace.astro";
import ConverterToolWorkspace from "@/components/tools/ConverterToolWorkspace.astro";
import { tools, getRelatedTools } from "@/data/tools";
import { categoryMap } from "@/data/categories";
import { getToolPath } from "@/types/tool";
import { getToolInstructions } from "@/data/toolInstructions";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: {
      category: tool.category,
      slug: tool.slug,
    },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const category = categoryMap.get(tool.category);
const relatedTools = getRelatedTools(tool);
const instructions = getToolInstructions(tool);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Tools",
      item: "https://toolsiva.com/tools",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: category?.name,
      item: `https://toolsiva.com/tools/${tool.category}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: tool.name,
      item: `https://toolsiva.com${getToolPath(tool)}`,
    },
  ],
};
---

<BaseLayout
  title={tool.name}
  description={tool.metaDescription}
  canonicalPath={getToolPath(tool)}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="mx-auto w-full max-w-[84rem] px-4 py-5 sm:px-5 lg:px-6 lg:py-6">
    <nav class="mb-3 text-xs text-zinc-500 sm:text-sm" aria-label="Breadcrumb">
      <a class="hover:text-white" href="/tools">Tools</a>
      <span class="mx-2">/</span>
      <a class="hover:text-white" href={`/tools/${tool.category}`}>{category?.name}</a>
      <span class="mx-2">/</span>
      <span>{tool.name}</span>
    </nav>

    <header class="mb-4">
      <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-300">
        Free online tool
      </p>
      <h1 class="text-2xl font-black tracking-tight text-white sm:text-3xl lg:text-[2.35rem]">{tool.name}</h1>
      <p class="mt-2.5 max-w-3xl text-sm leading-6 text-zinc-400 sm:text-base">{tool.shortDescription}</p>
    </header>

    <AdSlot placement="tool-top" minHeight={0} />

    {tool.category === "text" && <TextToolWorkspace mode={tool.slug} />}
    {tool.category === "developer" && <DeveloperToolWorkspace mode={tool.slug} />}
    {tool.category === "security" && <SecurityToolWorkspace mode={tool.slug} />}
    {tool.category === "qr" && <QrToolWorkspace mode={tool.slug} />}
    {tool.category === "calculator" && <CalculatorToolWorkspace mode={tool.slug} />}
    {tool.category === "converter" && <ConverterToolWorkspace mode={tool.slug} />}

    <section class="mt-10">
      <h2 class="text-xl font-bold text-white">How to use this tool</h2>
      <ol class="mt-3 grid gap-3 text-sm text-zinc-300 sm:grid-cols-3">
        {instructions.map((item, index) => (
          <li class="rounded-xl border border-white/10 p-4">
            <strong class="block text-white">{index + 1}. {item.title}</strong>
            <span class="mt-1.5 block text-xs leading-5 text-zinc-400">{item.description}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-16">
      <h2 class="text-xl font-bold text-white">Frequently asked questions</h2>
      <div class="mt-3 divide-y divide-white/10 rounded-xl border border-white/10 px-4">
        {
          tool.faq.map((item) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-semibold text-white">{item.question}</summary>
              <p class="mt-2.5 max-w-3xl text-sm leading-6 text-zinc-400">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    {
      relatedTools.length > 0 && (
        <section class="mt-16">
          <h2 class="text-xl font-bold text-white">Related tools</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedTools.map((related) => (
              <a
                class="rounded-xl border border-white/10 p-4 transition hover:border-brand-400/40"
                href={getToolPath(related)}
              >
                <strong>{related.name}</strong>
                <span class="mt-1.5 block text-xs leading-5 text-zinc-400">{related.shortDescription}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
