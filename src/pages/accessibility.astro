---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
---

<BaseLayout
  title="Accessibility"
  description="Toolsiva's accessibility approach and how to report an accessibility issue."
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-300">Accessibility</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">
      Building tools that are easier to use
    </h1>
    <div class="prose-premium mt-8 space-y-8 text-sm leading-7 text-zinc-300">
      <section>
        <h2>Our approach</h2>
        <p>
          Toolsiva aims to support keyboard navigation, visible focus indicators, semantic HTML,
          readable contrast, responsive layouts and clear form labels.
        </p>
      </section>
      <section>
        <h2>Known limitations</h2>
        <p>
          The site is actively evolving, and some complex editors, generated visual content or
          third-party browser controls may not yet provide an ideal experience for every assistive
          technology.
        </p>
      </section>
      <section>
        <h2>Report a problem</h2>
        <p>
          Send the affected page URL, browser, assistive technology and a description of the issue
          to <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
