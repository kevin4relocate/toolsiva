---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About Toolsiva" description="Learn about Toolsiva and its product principles.">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-4xl font-black text-white">About Toolsiva</h1>
    <p class="mt-6 text-lg leading-8 text-zinc-400">
      Toolsiva creates fast, focused online tools. We prioritize privacy, performance and simple
      workflows that do not require an account.
    </p>
  </article>
</BaseLayout>
