---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy" description="Toolsiva privacy policy.">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-4xl font-black text-white">Privacy Policy</h1>
    <p class="mt-6 leading-8 text-zinc-400">
      This foundation uses placeholder policy content. A complete production privacy policy will
      be added before analytics, advertising or server-side processing is enabled.
    </p>
  </article>
</BaseLayout>
