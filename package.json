{
  "name": "toolsiva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:validators": "node scripts/test-validator-fixtures.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "seo:audit": "node scripts/production-seo-audit.mjs",
    "seo:audit:strict": "node scripts/production-seo-audit.mjs --strict",
    "launch:check": "npm run check && npm run build && npm run seo:audit"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "24.1.0",
    "@types/qrcode": "^1.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.2",
    "wrangler": "4.114.0"
  }
}
