{
  "name": "toolsiva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:validators": "node scripts/test-validator-fixtures.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "seo:audit": "node scripts/production-seo-audit.mjs",
    "seo:audit:strict": "node scripts/production-seo-audit.mjs --strict",
    "launch:check": "npm run check && npm run build && npm run seo:audit",
    "blog:generate": "node scripts/generate-daily-blog.mjs",
    "blog:validate": "node scripts/validate-blog-links.mjs",
    "test:phase1": "node --experimental-strip-types --test tests/phase1.test.mjs",
    "test:phase2": "node --test tests/phase2.test.mjs",
    "tools:verify": "node scripts/verify-tool-routes.mjs",
    "test:phase3": "node --test tests/phase3.test.mjs",
    "analytics:verify": "node scripts/verify-analytics.mjs",
    "test:phase4": "node --experimental-strip-types --test tests/phase4.test.mjs",
    "test:phase5": "node --test tests/phase5.test.mjs",
    "test:phase6": "node --experimental-strip-types --test tests/phase6.test.mjs",
    "hardening:verify": "node scripts/verify-hardening.mjs",
    "test:phase7": "node --test tests/phase7.test.mjs",
    "adsense:audit": "node scripts/adsense-readiness-audit.mjs",
    "test:canonical-routing": "node --test tests/canonical-routing.test.mjs",
    "seo:canonical": "node scripts/verify-canonical-routing.mjs",
    "test:phase8": "node --test tests/phase8.test.mjs",
    "blog:publish-queue": "node scripts/publish-approved-blog.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.4",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "qrcode": "^1.5.4",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "24.1.0",
    "@types/qrcode": "^1.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.2",
    "wrangler": "4.114.0"
  }
}
